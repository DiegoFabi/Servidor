# ============================================================
#  sed.sk - Sed del jugador (como la barra de comida)
#
#  - Va de 0 a 20. Baja poco a poco: unos 40 s por punto quieto,
#    más rápido corriendo, nadando no, en el Nether y en zonas cálidas.
#    Llena -> vacía en ~13 min sin correr (unos 6-7 corriendo).
#  - Se recupera bebiendo botellas de agua (+6).
#  - A 0 hace daño (1 punto cada 5 s, como el hambre).
#  - Al llenarla del todo bebiendo cura 4 puntos de vida (2 corazones).
#  - Al morir vuelve a 20.
#  - No baja en el Lobby, en creativo ni en espectador.
#
#  La actionbar de AuraSkills la muestra con %typewriter_7dlWnPc7qOgTGUt%
#  (fact "sed_jugador" de TypeWriter): este script solo actualiza ese
#  fact cuando el valor cambia.
#
#  Rendimiento: un único "every 5 seconds" para todos los jugadores.
# ============================================================

options:
    max: 20
    # Puntos de "cansancio" para perder 1 de sed (cada 5 s se suma 1 quieto)
    umbral: 8
    agua: 6
    curacion: 4

# Guarda el valor y lo envía a TypeWriter solo si cambió
function sedPoner(p: player, v: number):
    set {_v} to max(0, min({@max}, {_v}))
    set {_u} to uuid of {_p}
    if {sed::%{_u}%} is {_v}:
        stop
    set {sed::%{_u}%} to {_v}
    execute console command "typewriter facts set sed_jugador %{_v}% %{_p}%"

function sedExenta(p: player) :: boolean:
    if gamemode of {_p} is creative or spectator:
        return true
    if "%world of {_p}%" is "Lobby":
        return true
    return false

on join:
    set {_u} to uuid of player
    if {sed::%{_u}%} is not set:
        set {sed::%{_u}%} to {@max}
    # Reenvía el valor actual al fact (por si TypeWriter se reinició)
    set {_v} to {sed::%{_u}%}
    execute console command "typewriter facts set sed_jugador %{_v}% %player%"

every 5 seconds:
    loop all players:
        set {_p} to loop-player
        # "if" (no condición suelta): una condición falsa cortaría el bucle entero
        if sedExenta({_p}) is false:
            sedTick({_p})

function sedTick(p: player):
    set {_u} to uuid of {_p}
    set {_s} to {sed::%{_u}%} ? {@max}
    if {_s} <= 0:
        damage {_p} by 0.5
        send action bar "<#5CE1E6>≈ <#FF6B6B>¡Tienes sed! Bebe una botella de agua." to {_p}
        stop
    set {_c} to 1
    if {_p} is sprinting:
        add 2 to {_c}
    if {_p} is in water:
        set {_c} to 0
    if "%world of {_p}%" contains "nether":
        add 1 to {_c}
    if temperature of block at {_p} > 1:
        add 1 to {_c}
    add {_c} to {-sed::cansancio::%{_u}%}
    if {-sed::cansancio::%{_u}%} >= {@umbral}:
        set {-sed::cansancio::%{_u}%} to 0
        sedPoner({_p}, {_s} - 1)

on consume:
    event-item is water bottle
    set {_u} to uuid of player
    set {_antes} to {sed::%{_u}%} ? {@max}
    set {_ahora} to min({@max}, {_antes} + {@agua})
    sedPoner(player, {_ahora})
    play sound "entity.generic.drink" with volume 0.6 to player
    if {_antes} < {@max}:
        if {_ahora} = {@max}:
            heal player by {@curacion} / 2
            send action bar "<#5CE1E6>≈ <#C9CDD6>Sed saciada <dark_gray>• <#FF6B6B>+2 ❤" to player

on respawn:
    set {-sed::cansancio::%uuid of player%} to 0
    sedPoner(player, {@max})
