# ============================================================
#  bajo_nombre.sk - Línea bajo el nombre del jugador
#  Requiere: Skript 2.10+ y SkBee 3.4+ (objetivos y number format)
#
#  Debajo del nametag (el de SunLight) se ve:  ❤ vida · ⚔ kills · ☠ muertes
#  Es lo que antes mostraba TAB con belowname-objective; SunLight no lo
#  tiene, así que se hace con un objetivo del scoreboard principal en el
#  hueco "below_name" y un formato de texto propio por jugador.
#
#  Rendimiento: solo por eventos (entrar, daño, curación, muerte y
#  reaparición). Varios cambios en el mismo tick se agrupan en una sola
#  actualización por jugador. Sin temporizadores.
# ============================================================

on load:
    set {-bn::obj} to objective with id "bajonombre"
    if {-bn::obj} is not set:
        set {-bn::obj} to objective with id "bajonombre" with criteria "dummy" named "" in display slot below_name
    set display slot of {-bn::obj} to below_name
    loop all players:
        bnActualizar(loop-player)

function bnActualizar(p: player):
    {-bn::obj} is set
    {_p} is online
    set {_vida} to round(health of {_p} * 2)
    set {_kills} to player kills stat of {_p}
    set {_muertes} to deaths stat of {_p}
    set score of {_p} for {-bn::obj} to 0
    set number format of {-bn::obj} for {_p} to mini message from "<#EA8FFA>%{_vida}% ꑖ <gray>· <#F7F092>%{_kills}% ꑧ <gray>· <#8AFFED>%{_muertes}% ꑭ"

# Agrupa varias actualizaciones del mismo jugador en una (1 tick)
function bnPendiente(p: player):
    set {_u} to uuid of {_p}
    {-bn::pend::%{_u}%} is not set
    set {-bn::pend::%{_u}%} to true
    wait 1 tick
    delete {-bn::pend::%{_u}%}
    bnActualizar({_p})

on join:
    bnPendiente(player)

on damage of a player:
    set {_v} to victim
    bnPendiente({_v})

on heal of a player:
    set {_v} to event-entity
    bnPendiente({_v})

on death of a player:
    set {_v} to victim
    bnPendiente({_v})
    attacker is a player
    set {_a} to attacker
    bnPendiente({_a})

on respawn:
    bnPendiente(player)

on quit:
    delete {-bn::pend::%uuid of player%}
