# ============================================================
#  particulas_cosmeticas.sk - Partículas cosméticas exclusivas
#  Solo decorativas (no son poderes ni hacen daño). Se compran con
#  Shards desde CoreTools (Personalización > Partículas): CoreTools
#  cobra con currency{...} y da el permiso; este script las muestra.
#
#  Comando: /particula usar <id>  |  /particula quitar  |  /particula lista
#  Permiso de cada partícula: cosmetico.particula.<id>  (lo da la compra)
#
#  Partículas (7):
#    alma      Almas que orbitan a tus pies
#    cerezo    Pétalos de cerezo que caen a tu alrededor
#    chispas   Halo eléctrico sobre tu cabeza
#    brasas    Estela de brasas al caminar
#    melodia   Notas musicales que flotan sobre ti
#    corazones Corona de corazones
#    escarcha  Espiral de copos de nieve
#
#  Rendimiento:
#  - Un solo bucle por jugador con partícula activa (5 fps, 1-3
#    partículas por fotograma), que termina al quitarla o salir.
#  - No se dibuja si el jugador está invisible o en espectador.
#  - La partícula elegida se guarda y se reactiva al entrar.
# ============================================================

options:
    prefijo: <dark_gray>┃ <light_purple><bold>Partículas</bold> <dark_gray>»<reset>

function pcNombre(id: text) :: text:
    if {_id} is "alma":
        return "<#9FE8FF>Aura de Almas"
    else if {_id} is "cerezo":
        return "<#FFB7D5>Pétalos de Cerezo"
    else if {_id} is "chispas":
        return "<#FFF3A6>Halo Eléctrico"
    else if {_id} is "brasas":
        return "<#FF9A5C>Estela de Brasas"
    else if {_id} is "melodia":
        return "<#B8FFC9>Melodía"
    else if {_id} is "corazones":
        return "<#FF8FA8>Corona de Corazones"
    else if {_id} is "escarcha":
        return "<#CFF4FF>Espiral de Escarcha"

# Bucle de dibujo (uno por jugador mientras la partícula esté activa)
function pcBucle(p: player, id: text):
    set {_u} to uuid of {_p}
    set {_f} to 0
    set {_prev} to location of {_p}
    while {cosm::particula::%{_u}%} is {_id}:
        if {_p} is not online:
            stop
        if all:
            {_p} is not invisible
            gamemode of {_p} is not spectator
        then:
            set {_l} to location of {_p}
            if {_id} is "alma":
                make 1 of soul at fxRing({_l}, 0.6, 2, 0.15, {_f} * 24) with extra 0
            else if {_id} is "cerezo":
                make 1 of cherry_leaves at {_l} offset by vector(0, 2.3, 0) with offset vector(0.5, 0.1, 0.5) with extra 0
            else if {_id} is "chispas":
                make 1 of electric_spark at fxRing({_l}, 0.35, 3, 2.25, {_f} * 30) with extra 0
            else if {_id} is "brasas":
                if distance between {_l} and {_prev} > 0.15:
                    make 2 of small_flame at {_l} offset by vector(0, 0.1, 0) with offset vector(0.15, 0, 0.15) with extra 0.005
            else if {_id} is "melodia":
                if mod({_f}, 3) = 0:
                    make 1 of note at {_l} offset by vector(0, 2.4, 0) with offset vector(0.3, 0.1, 0.3) with extra 1
            else if {_id} is "corazones":
                if mod({_f}, 2) = 0:
                    make 1 of heart at fxRing({_l}, 0.45, 3, 2.3, {_f} * 20) with extra 0
            else if {_id} is "escarcha":
                set {_h} to mod({_f}, 10) * 0.2
                make 1 of snowflake at fxRing({_l}, 0.55, 2, {_h}, {_f} * 36) with extra 0
            set {_prev} to {_l}
        add 1 to {_f}
        wait 4 ticks

function pcActivar(p: player, id: text):
    set {cosm::particula::%uuid of {_p}%} to {_id}
    wait 5 ticks
    pcBucle({_p}, {_id})

command /particula [<text>] [<text>]:
    aliases: /particulas
    trigger:
        if arg-1 is "usar":
            set {_id} to lowercase arg-2
            if pcNombre({_id}) is not set:
                send "{@prefijo} <#FF6B6B>Esa partícula no existe."
                stop
            if player does not have permission "cosmetico.particula.%{_id}%":
                send "{@prefijo} <#FF6B6B>No tienes esa partícula. <#9EA3AE>Cómprala en Personalización > Partículas."
                stop
            # Si ya está activa no se crea otro bucle
            if {cosm::particula::%uuid of player%} is not {_id}:
                pcActivar(player, {_id})
            send action bar "<#C9CDD6>Partícula activa <dark_gray>» %pcNombre({_id})%"
            play sound "block.amethyst_block.chime" with volume 0.8 and pitch 1.4 to player
        else if arg-1 is "quitar":
            delete {cosm::particula::%uuid of player%}
            send action bar "<#9EA3AE>Partícula desactivada"
            play sound "block.note_block.hat" with volume 0.8 to player
        else:
            send "{@prefijo} <#C9CDD6>Tus partículas:"
            loop "alma", "cerezo", "chispas", "brasas", "melodia", "corazones" and "escarcha":
                if player has permission "cosmetico.particula.%loop-value%":
                    send formatted "  <click:run_command:'/particula usar %loop-value%'>%pcNombre(loop-value)% <dark_gray>» <#7FB2FF>[Usar]</click>"
            send formatted "  <click:run_command:'/particula quitar'><#FF6B6B>[Quitar partícula]</click>"

on join:
    set {_id} to {cosm::particula::%uuid of player%}
    {_id} is set
    wait 3 seconds
    player is online
    pcBucle(player, {_id})
