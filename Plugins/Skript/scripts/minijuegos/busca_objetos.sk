# ============================================================
#  busca_objetos.sk - Minijuego "Busca Objetos"
#  Requiere: Skript 2.10+ y Vault (money de ExcellentEconomy)
#
#  1v1 (cada 80 minutos en el chat):
#   - Se anuncia un duelo con botón [Unirse] (máx. 2 jugadores, 60 s).
#   - Al unirse se cobra la apuesta; con 2 jugadores: 10 s de cuenta
#     atrás (title solo para ellos) y se revela el bloque a conseguir.
#   - 3 minutos: el primero que lo tenga en el inventario gana el bote
#     (las dos apuestas). Si nadie lo consigue, se devuelve el dinero.
#  Ruleta roja (todos): boRuletaGlobal() elige un bloque; quien no lo
#  tenga en el inventario a los 3 minutos pierde esa cantidad.
#
#  Bloques: 16 bloques difíciles (hierro, lapislázuli, redstone, oro, cuarzo,
#   obsidiana llorona, amatista, miel, slime, linterna marina, esmeralda,
#   piedra del End, diamante, púrpura, escombro ancestral y netherita) con
#   apuesta de 1000 a 5000 según dificultad. Lista editable en "on load".
#
#  Comandos: /buscaobjetos unirse | salir
#            /buscaobjetos iniciar (admin: busca.admin)
#  Rendimiento:
#   - Turno por reloj cada 90 min (lanza el anuncio si no hay partida).
#   - La detección es por eventos (recoger, craftear, mover objetos en el
#     inventario) y solo comprueba a los 2 participantes.
#   - Solo variables en memoria {-bo::*}.
# ============================================================

options:
    # Sin colores hex (#) aqui: en las opciones '#' inicia un comentario de Skript
    prefijo: <gradient:aqua:dark_aqua><bold>Busca Objetos</bold></gradient> <dark_gray>»<reset>
    tiempo: 180
    inscripcion: 60
    min-jugadores: 2

# Bloques posibles: "tipo|Nombre|apuesta". La apuesta sube con la dificultad
# (de 1000 a 5000). Añade o quita líneas aquí; se elige uno al azar.
on load:
    delete {-bo::*}
    delete {-bog::*}
    add "iron block|Bloque de Hierro|1000" to {-bo::bloques::*}
    add "lapis block|Bloque de Lapislázuli|1200" to {-bo::bloques::*}
    add "redstone block|Bloque de Redstone|1200" to {-bo::bloques::*}
    add "gold block|Bloque de Oro|1500" to {-bo::bloques::*}
    add "quartz block|Bloque de Cuarzo|1500" to {-bo::bloques::*}
    add "crying obsidian|Obsidiana Llorona|1800" to {-bo::bloques::*}
    add "amethyst block|Bloque de Amatista|1800" to {-bo::bloques::*}
    add "honey block|Bloque de Miel|2000" to {-bo::bloques::*}
    add "slime block|Bloque de Slime|2000" to {-bo::bloques::*}
    add "sea lantern|Linterna Marina|2200" to {-bo::bloques::*}
    add "emerald block|Bloque de Esmeralda|2500" to {-bo::bloques::*}
    add "end stone|Piedra del End|3000" to {-bo::bloques::*}
    add "diamond block|Bloque de Diamante|3500" to {-bo::bloques::*}
    add "purpur block|Bloque de Púrpura|3500" to {-bo::bloques::*}
    add "ancient debris|Escombro Ancestral|4000" to {-bo::bloques::*}
    add "netherite block|Bloque de Netherita|5000" to {-bo::bloques::*}

# Elige un bloque al azar de la lista (todos con la misma probabilidad)
function boElegir(pre: text):
    set {_lista::*} to {-bo::bloques::*}
    set {_linea} to random element out of {_lista::*}
    set {_d::*} to split {_linea} at "|"
    set {_t} to {_d::1} parsed as itemtype
    set {_nom} to {_d::2}
    set {_a} to {_d::3} parsed as number
    if {_pre} is "bo":
        set {-bo::tipo} to {_t}
        set {-bo::nombre} to {_nom}
        set {-bo::apuesta} to {_a}
    else:
        set {-bog::tipo} to {_t}
        set {-bog::nombre} to {_nom}
        set {-bog::apuesta} to {_a}

function boEnJuego(p: player) :: boolean:
    if {-bo::estado} is "juego":
        if {-bo::jugadores::*} contains {_p}:
            return true
    return false

function boDevolver():
    loop {-bo::jugadores::*}:
        add {-bo::apuesta} to loop-value's balance
        if loop-value is online:
            send "{@prefijo} <#C9CDD6>Se te devolvieron <#7FFF9E>$%{-bo::apuesta}%<#C9CDD6>." to loop-value

# ------------------------------------------------------------
#  1v1
# ------------------------------------------------------------
function boAnunciar():
    {-bo::estado} is not set
    add 1 to {-bo::id}
    set {_id} to {-bo::id}
    boElegir("bo")
    set {-bo::estado} to "inscripcion"
    delete {-bo::jugadores::*}
    loop all players:
        notificar(loop-player)
        boArriba(loop-player, "<#7FDCE6>— ✧ Anuncios de Eventos ✧ —", "<#3FD0DE><bold>BUSCA OBJETOS</bold>")
        boLinea(loop-player, "<white>¡Duelo 1v1! <#C9CDD6>El primero en conseguir el bloque")
        boLinea(loop-player, "<#C9CDD6>gana el bote de <#7FDCE6>$%{-bo::apuesta} * 2%")
        send "" to loop-player
        boLinea(loop-player, "<#7FDCE6>✧ <click:run_command:'/buscaobjetos unirse'><hover:show_text:'<#7FDCE6>Apostar $%{-bo::apuesta}% y unirte'><#7FDCE6>¡Click para <bold>UNIRTE</bold>!</hover></click> <#7FDCE6>✧")
        boAbajo(loop-player)
    wait {@inscripcion} seconds
    {-bo::id} = {_id}
    {-bo::estado} is "inscripcion"
    # No se llenó: se cancela y se devuelve el dinero
    boDevolver()
    send "{@prefijo} <#9EA3AE>Nadie más se unió; el duelo se canceló." to all players
    delete {-bo::estado}
    delete {-bo::jugadores::*}

function boEmpezar():
    set {_id} to {-bo::id}
    set {-bo::estado} to "espera"
    loop 10 times:
        if {-bo::id} is not {_id}:
            stop
        set {_s} to 11 - loop-number
        loop {-bo::jugadores::*}:
            if loop-value-2 is online:
                send title "<#5FE3FF><bold>%{_s}%" with subtitle "<#C9CDD6>Prepárate para buscar..." to loop-value-2 for 25 ticks with fadein 0 ticks and fadeout 5 ticks
                play sound "block.note_block.hat" with volume 0.6 and pitch (0.8 + loop-number-1 * 0.08) to loop-value-2
        wait 1 second
    {-bo::id} = {_id}
    set {-bo::estado} to "juego"
    loop {-bo::jugadores::*}:
        if loop-value is online:
            send title "<#5FE3FF>¡Busca!" with subtitle "<white>%{-bo::nombre}%" to loop-value for 2 seconds with fadein 0 ticks and fadeout 10 ticks
            send "{@prefijo} <#C9CDD6>Consigue <white><bold>%{-bo::nombre}%</bold> <#C9CDD6>antes que tu rival. Tienes <#FFD36B>3 minutos<#C9CDD6>." to loop-value
            play sound "block.amethyst_block.chime" with volume 0.8 and pitch 1.4 to loop-value
            # Puede que ya lo tenga encima
            if loop-value has {-bo::tipo}:
                boGanar(loop-value)
                stop
    wait {@tiempo} seconds
    {-bo::id} = {_id}
    {-bo::estado} is "juego"
    send "{@prefijo} <#9EA3AE>Se acabó el tiempo y nadie consiguió <white>%{-bo::nombre}%<#9EA3AE>." to all players
    boDevolver()
    delete {-bo::estado}
    delete {-bo::jugadores::*}

function boGanar(p: player):
    {-bo::estado} is "juego"
    delete {-bo::estado}
    add 1 to {-bo::id}
    set {_bote} to {-bo::apuesta} * 2
    add {_bote} to {_p}'s balance
    send title "<#7FFF9E><bold>¡Ganaste!" with subtitle "<#C9CDD6>+$%{_bote}%" to {_p} for 3 seconds with fadein 5 ticks and fadeout 10 ticks
    play sound "ui.toast.challenge_complete" with volume 0.6 to {_p}
    send "{@prefijo} <white>%{_p}% <#C9CDD6>encontró <white>%{-bo::nombre}% <#C9CDD6>y gana <#7FFF9E><bold>$%{_bote}%</bold><#C9CDD6>." to all players
    delete {-bo::jugadores::*}

# Detección por eventos (solo participantes)
on pick up:
    {-bo::estado} is "juego"
    boEnJuego(player) is true
    wait 1 tick
    player is online
    player has {-bo::tipo}
    boGanar(player)

on craft:
    {-bo::estado} is "juego"
    boEnJuego(player) is true
    wait 1 tick
    player is online
    player has {-bo::tipo}
    boGanar(player)

on inventory click:
    {-bo::estado} is "juego"
    boEnJuego(player) is true
    wait 1 tick
    player is online
    player has {-bo::tipo}
    boGanar(player)

on quit:
    {-bo::jugadores::*} contains player
    if {-bo::estado} is "inscripcion":
        add {-bo::apuesta} to player's balance
        remove player from {-bo::jugadores::*}
    else if {-bo::estado} is "juego":
        # Abandona: gana el rival que sigue conectado
        loop {-bo::jugadores::*}:
            if loop-value is not player:
                set {_rival} to loop-value
        if {_rival} is online:
            boGanar({_rival})

# Turno fijo por reloj: cada 90 min (minuto 10 del ciclo). Los minijuegos usan
# ciclos 45/60/90 con desfase 0/5/10, así nunca coinciden y quedan al menos 5 min entre ellos.
every 1 minute:
    mod(floor(unix timestamp of now / 60), 90) is 10
    number of all players >= {@min-jugadores}
    loop 20 times:
        if boLibre() is true:
            exit loop
        wait 30 seconds
    boMarcar()
    boAnunciar()

# ------------------------------------------------------------
#  Ruleta roja: búsqueda para todos
#  Rellena {-bog::nombre} y {-bog::apuesta} al instante (los usa la
#  ruleta para el título) y comprueba a los 3 minutos.
# ------------------------------------------------------------
function boRuletaGlobal():
    {-bog::activo} is not set
    set {-bog::activo} to true
    boElegir("bog")
    wait 8 seconds
    loop all players:
        notificar(loop-player)
        send "{@prefijo} <#FF6B6B>Consigue <white><bold>%{-bog::nombre}%</bold> <#FF6B6B>en 3 minutos o perderás <#FFD36B>$%{-bog::apuesta}%<#FF6B6B>." to loop-player
    wait 150 seconds
    send "{@prefijo} <#FFB347>¡Quedan 30 segundos para conseguir <white>%{-bog::nombre}%<#FFB347>!" to all players
    wait 30 seconds
    set {_a} to 0
    set {_p} to 0
    loop all players:
        if loop-player has {-bog::tipo}:
            add 1 to {_a}
            send action bar "<#7FFF9E>✔ A salvo: tienes %{-bog::nombre}%" to loop-player
        else:
            set {_q} to {-bog::apuesta}
            if loop-player's balance < {_q}:
                set {_q} to loop-player's balance
            if {_q} > 0:
                remove {_q} from loop-player's balance
            add 1 to {_p}
            send "{@prefijo} <#FF6B6B>No conseguiste <white>%{-bog::nombre}%<#FF6B6B>: pierdes <#FFD36B>$%{_q}%<#FF6B6B>." to loop-player
            play sound "entity.villager.no" with volume 0.6 to loop-player
    send "{@prefijo} <#C9CDD6>Fin de la búsqueda: <#7FFF9E>%{_a}% a salvo <dark_gray>• <#FF6B6B>%{_p}% pagaron." to all players
    delete {-bog::*}

# ------------------------------------------------------------
#  Comando
# ------------------------------------------------------------
command /buscaobjetos [<text>]:
    aliases: /busca
    trigger:
        if arg-1 is "unirse":
            if {-bo::estado} is not "inscripcion":
                send "{@prefijo} <#FF6B6B>No hay ningún duelo abierto."
                stop
            if {-bo::jugadores::*} contains player:
                send "{@prefijo} <#FFB347>Ya estás inscrito."
                stop
            if size of {-bo::jugadores::*} >= 2:
                send "{@prefijo} <#FF6B6B>El duelo ya está completo."
                stop
            if player's balance < {-bo::apuesta}:
                send "{@prefijo} <#FF6B6B>Necesitas <#7FFF9E>$%{-bo::apuesta}% <#FF6B6B>para unirte."
                stop
            remove {-bo::apuesta} from player's balance
            add player to {-bo::jugadores::*}
            send "{@prefijo} <white>%player% <#C9CDD6>se une al duelo <dark_gray>(%size of {-bo::jugadores::*}%/2)" to all players
            if size of {-bo::jugadores::*} >= 2:
                boEmpezar()
        else if arg-1 is "salir":
            if {-bo::estado} is "inscripcion":
                if {-bo::jugadores::*} contains player:
                    remove player from {-bo::jugadores::*}
                    add {-bo::apuesta} to player's balance
                    send "{@prefijo} <#9EA3AE>Saliste del duelo y recuperaste tu apuesta."
        else if arg-1 is "iniciar":
            if player does not have permission "busca.admin":
                send "{@prefijo} <#FF6B6B>No tienes permiso."
                stop
            boAnunciar()
        else:
            send "{@prefijo} <#C9CDD6>Cada 80 minutos se abre un duelo 1v1: el primero en conseguir el bloque gana el bote."

# ------------------------------------------------------------
#  Formato del anuncio (centrado automático, sin etiquetas)
# ------------------------------------------------------------
function boAncho(t: text) :: number:
    set {_w} to 0
    set {_tag} to false
    set {_bold} to false
    set {_nombre} to ""
    loop length of {_t} times:
        set {_c} to subtext of {_t} from characters loop-number to loop-number
        if {_tag} is true:
            # Lo que va entre comillas (texto de hover, comandos) no se ve
            if {_c} is "'" or """":
                if {_q} is not set:
                    set {_q} to {_c}
                else if {_q} is {_c}:
                    delete {_q}
            else if {_q} is set:
                set {_nombre} to {_nombre}
            else if {_c} is ">":
                set {_tag} to false
                if {_nombre} is "bold" or "b":
                    set {_bold} to true
                else if {_nombre} is "/bold" or "/b" or "reset":
                    set {_bold} to false
            else:
                set {_nombre} to "%{_nombre}%%{_c}%"
        else if {_c} is "<":
            set {_tag} to true
            set {_nombre} to ""
        else:
            add 5.6 to {_w}
            if {_bold} is true:
                add 1 to {_w}
    return {_w}

function boCentrar(t: text) :: text:
    set {_n} to rounded down ((320 - boAncho({_t})) / 8)
    set {_pad} to ""
    if {_n} > 0:
        loop {_n} times:
            set {_pad} to "%{_pad}% "
    return "%{_pad}%%{_t}%"

function boArriba(p: players, cabecera: text, titulo: text):
    send "" to {_p::*}
    send formatted boCentrar({_cabecera}) to {_p::*}
    send "" to {_p::*}
    send formatted boCentrar({_titulo}) to {_p::*}
    send "" to {_p::*}

function boLinea(p: players, t: text):
    send formatted boCentrar({_t}) to {_p::*}

function boAbajo(p: players):
    send "" to {_p::*}
    send "                           <#C9CDD6>⟐ ¡Apoya al Servidor!" to {_p::*}
    send "" to {_p::*}

# ------------------------------------------------------------
#  Turno: no coincidir con otro anuncio automático (Skript o SunLight).
#  {-an::*} es compartido por todos los scripts de anuncios.
#  1020 = "Interval" de SunLight/modules/scheduler/announcers/global.yml
# ------------------------------------------------------------
function boLibre() :: boolean:
    set {_t} to unix timestamp of now
    if {_t} - ({-an::ultimo} ? 0) < 300:
        return false
    set {_m} to mod({_t} - {-an::inicio}, 1020)
    if {_m} < 150:
        return false
    if {_m} > 1020 - 150:
        return false
    return true

function boMarcar():
    set {-an::ultimo} to unix timestamp of now


on load:
    if {-an::inicio} is not set:
        set {-an::inicio} to unix timestamp of now
