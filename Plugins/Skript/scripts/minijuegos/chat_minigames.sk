# ============================================================
#  chat_minigames.sk - Minijuegos de chat con recompensa
#  Requiere: Skript 2.10+ (tags MiniMessage) y Vault
#
#  Economia: ExcellentEconomy expone la moneda "money" como
#  economia de Vault (config.yml -> Integration.Vault.EconomyCurrency: money),
#  por eso "player's balance" opera directamente sobre ExcellentEconomy money
#  en memoria, sin ejecutar comandos ni leer archivos.
#
#  Rendimiento:
#  - Un unico evento periodico cada 10 minutos (no hay bucles, ni
#    "every second", ni "while" con esperas).
#  - Solo variables en memoria ({-mg::*}): no se escriben en disco.
#  - El evento de chat es asincrono: se descarta todo lo que no es la
#    respuesta con comparaciones baratas, y solo la respuesta correcta
#    pasa al hilo principal (wait 1 tick) donde se reclama el premio de
#    forma atomica, asi dos jugadores no pueden cobrar el mismo juego.
# ============================================================

options:
    # Recompensa aleatoria (money de ExcellentEconomy)
    min-premio: 500
    max-premio: 1000
    # Segundos para responder antes de que el juego expire
    duracion: 60
    # Jugadores minimos conectados para lanzar un juego
    min-jugadores: 1
    # Sin colores hex (#) aqui: en las opciones '#' inicia un comentario de Skript
    prefijo: <gradient:gold:yellow><bold>MiniJuego</bold></gradient> <dark_gray>»<reset>

# ------------------------------------------------------------
#  Lista de palabras (hardcodeada). Se carga una sola vez en memoria.
# ------------------------------------------------------------
on load:
    delete {-mg::*}
    set {-mg::palabras::*} to "minecraft", "diamante", "esmeralda", "creeper", "aldeano", "espada", "armadura", "obsidiana", "portal", "dragon", "encantamiento", "pocion", "redstone", "castillo", "molino", "servidor", "aventura", "tesoro", "calabaza", "esqueleto", "zombie", "netherita", "biblioteca", "antorcha", "caballo", "arquero", "herrero", "cofre", "mineral" and "bosque"
    set {-mg::activo} to true

# ------------------------------------------------------------
#  Programador: 1 minijuego cada 35 minutos (separado de los demás
#  anuncios con mgLibre/mgMarcar, al final del script)
# ------------------------------------------------------------
# Turno fijo por reloj: cada 45 min (minuto 0 del ciclo). Los minijuegos usan
# ciclos 45/60/90 con desfase 0/5/10, así nunca coinciden y quedan al menos 5 min entre ellos.
every 1 minute:
    mod(floor(unix timestamp of now / 60), 45) is 0
    {-mg::activo} is true
    {-mg::id} is not set
    number of all players >= {@min-jugadores}
    loop 20 times:
        if mgLibre() is true:
            exit loop
        wait 30 seconds
    mgMarcar()
    {-mg::id} is not set
    mgIniciar()

# ------------------------------------------------------------
#  Logica del juego
# ------------------------------------------------------------
# tipo:  aleatorio | matematicas | suma | resta | multiplicacion | division | palabra
# premio: -1 = aleatorio entre min-premio y max-premio
function mgIniciar(tipo: text = "aleatorio", premio: number = -1):
    {-mg::id} is not set
    set {_id} to random integer between 1 and 999999999
    set {_op} to 0
    if {_tipo} is "suma":
        set {_op} to 1
    else if {_tipo} is "resta":
        set {_op} to 2
    else if {_tipo} is "multiplicacion":
        set {_op} to 3
    else if {_tipo} is "division":
        set {_op} to 4
    if {_op} > 0:
        set {_juego} to 1
    else if {_tipo} is "matematicas":
        set {_juego} to 1
    else if {_tipo} is "palabra":
        set {_juego} to 2
    else:
        set {_juego} to random integer between 1 and 2
    if {_juego} = 1:
        if {_op} = 0:
            set {_op} to random integer between 1 and 4
        if {_op} = 1:
            set {_a} to random integer between 10 and 150
            set {_b} to random integer between 10 and 150
            set {_r} to {_a} + {_b}
            set {_s} to "+"
        else if {_op} = 2:
            set {_a} to random integer between 20 and 200
            set {_b} to random integer between 1 and {_a}
            set {_r} to {_a} - {_b}
            set {_s} to "-"
        else if {_op} = 3:
            set {_a} to random integer between 2 and 15
            set {_b} to random integer between 2 and 15
            set {_r} to {_a} * {_b}
            set {_s} to "x"
        else:
            # Division siempre exacta: a = b * r
            set {_b} to random integer between 2 and 12
            set {_r} to random integer between 2 and 12
            set {_a} to {_b} * {_r}
            set {_s} to "÷"
        set {-mg::respuesta} to "%{_r}%"
        set {_reto} to "<white>¡Resuelve <#FFD36B>(%{_a}% %{_s}% %{_b}%)</#FFD36B> en menos de <#7FFF9E>{@duracion}s</#7FFF9E> para ganar!"
        set {_plano} to "¡Resuelve (%{_a}% %{_s}% %{_b}%) en menos de {@duracion}s para ganar!"
    else:
        set {_w} to random element out of {-mg::palabras::*}
        set {-mg::respuesta} to {_w}
        set {_len} to length of {_w}
        loop {_len} times:
            add subtext of {_w} from characters loop-number to loop-number to {_c::*}
        # Mezcla las letras; reintenta (max 5) si queda igual a la original
        loop 5 times:
            set {_mezcla} to join (shuffled {_c::*}) with ""
            if {_mezcla} is not {_w}:
                exit loop
        set {_reto} to "<white>¡Ordena <#FFD36B>(%{_mezcla}%)</#FFD36B> en menos de <#7FFF9E>{@duracion}s</#7FFF9E> para ganar!"
        set {_plano} to "¡Ordena (%{_mezcla}%) en menos de {@duracion}s para ganar!"

    if {_premio} > 0:
        set {-mg::premio} to rounded {_premio}
    else:
        set {-mg::premio} to random integer between {@min-premio} and {@max-premio}
    set {-mg::id} to {_id}
    set {-mg::inicio} to now

    mgAnuncio({_reto}, {_plano}, "<#9EA3AE>Premio: <#7FFF9E>$%{-mg::premio}% <dark_gray>• <#9EA3AE>Escribe la respuesta en el chat", "Premio: $%{-mg::premio}% • Escribe la respuesta en el chat")
    play sound "block.note_block.pling" with volume 0.6 and pitch 1.4 to all players

    # Una sola tarea diferida (no es un temporizador repetitivo)
    wait {@duracion} seconds
    {-mg::id} = {_id}
    mgAnuncio("<#FF6B6B>⌛ ¡Tiempo agotado!", "⌛ ¡Tiempo agotado!", "<#9EA3AE>La respuesta era: <#FFD36B>%{-mg::respuesta}%", "La respuesta era: %{-mg::respuesta}%")
    mgLimpiar()

# ------------------------------------------------------------
#  Anuncio con el formato de eventos (líneas centradas en el chat)
# ------------------------------------------------------------
function mgCentrar(t: text, plano: text) :: text:
    set {_n} to rounded down ((320 - (length of {_plano}) * 5.6) / 8)
    set {_pad} to ""
    if {_n} > 0:
        loop {_n} times:
            set {_pad} to "%{_pad}% "
    return "%{_pad}%%{_t}%"

function mgAnuncio(a: text, aplano: text, b: text, bplano: text):
    send "" to all players
    send "                     <#7FDCE6>— ✧ Anuncios de Eventos ✧ —" to all players
    send "" to all players
    send "                        <#3FD0DE><bold>MINIJUEGOS DEL CHAT" to all players
    send "" to all players
    send mgCentrar({_a}, {_aplano}) to all players
    send mgCentrar({_b}, {_bplano}) to all players
    send "" to all players
    send "                           <#C9CDD6>⟐ ¡Apoya al Servidor!" to all players
    send "" to all players

function mgLimpiar():
    delete {-mg::id}
    delete {-mg::respuesta}
    delete {-mg::premio}
    delete {-mg::inicio}

# ------------------------------------------------------------
#  Respuestas (evento asincrono)
# ------------------------------------------------------------
on chat:
    {-mg::id} is set
    set {_m} to message
    replace all " " in {_m} with ""
    # Comparacion sin distinguir mayusculas (case sensitive: false en config.sk)
    {_m} is {-mg::respuesta}
    cancel event
    set {_id} to {-mg::id}
    # Pasar al hilo principal: aqui la reclamacion es atomica
    wait 1 tick
    {-mg::id} = {_id}
    player is online
    set {_premio} to {-mg::premio}
    set {_resp} to {-mg::respuesta}
    set {_t} to difference between {-mg::inicio} and now
    mgLimpiar()
    add {_premio} to player's balance
    mgAnuncio("<#FFD36B>¡<white>%player's name%<#FFD36B> ganó el minijuego!", "¡%player's name% ganó el minijuego!", "<#9EA3AE>Respuesta: <white>%{_resp}% <dark_gray>• <#9EA3AE>Premio: <#7FFF9E>+$%{_premio}% <dark_gray>• <#9EA3AE>Tiempo: <#7FDCE6>%{_t}%", "Respuesta: %{_resp}% • Premio: +$%{_premio}% • Tiempo: %{_t}%")
    play sound "entity.player.levelup" with volume 0.7 and pitch 1.2 to player
    play sound "entity.experience_orb.pickup" with volume 0.4 and pitch 1.6 to all players

# ------------------------------------------------------------
#  Administracion
#   /mj iniciar [tipo] [recompensa]   -> lanza un juego manualmente
#   /mj stop                          -> detiene el juego actual
#   /mj on|off                        -> juegos automaticos cada 10 min
#  Tipos: aleatorio, matematicas, suma, resta, multiplicacion, division, palabra
# ------------------------------------------------------------
command /minijuego [<text>] [<text>] [<text>]:
    aliases: /mj
    permission: server.admin
    trigger:
        if arg-1 is "iniciar" or "start":
            if {-mg::id} is set:
                send "{@prefijo} <red>Ya hay un minijuego en curso. <gray>Usa <yellow>/mj stop<gray>."
                stop
            set {_tipo} to "aleatorio"
            set {_premio} to -1
            if arg-2 is set:
                set {_n} to arg-2 parsed as number
                if {_n} is set:
                    set {_premio} to {_n}
                else if arg-2 is "aleatorio" or "matematicas" or "suma" or "resta" or "multiplicacion" or "division" or "palabra":
                    set {_tipo} to arg-2
                else:
                    send "{@prefijo} <red>Tipo inválido. <gray>Usa: <yellow>aleatorio, matematicas, suma, resta, multiplicacion, division, palabra"
                    stop
            if arg-3 is set:
                set {_n} to arg-3 parsed as number
                if {_n} is not set:
                    send "{@prefijo} <red>La recompensa debe ser un número."
                    stop
                set {_premio} to {_n}
            if {_premio} is not -1:
                if {_premio} <= 0:
                    send "{@prefijo} <red>La recompensa debe ser mayor que 0."
                    stop
            send "{@prefijo} <green>Minijuego lanzado: <yellow>%{_tipo}%"
            mgIniciar({_tipo}, {_premio})
        else if arg-1 is "stop" or "cancelar":
            if {-mg::id} is set:
                set {_resp} to {-mg::respuesta}
                mgLimpiar()
                mgAnuncio("<#FFB347>El minijuego fue detenido por un administrador", "El minijuego fue detenido por un administrador", "<#9EA3AE>La respuesta era: <#FFD36B>%{_resp}%", "La respuesta era: %{_resp}%")
            else:
                send "{@prefijo} <red>No hay ningún minijuego activo."
        else if arg-1 is "on":
            set {-mg::activo} to true
            send "{@prefijo} <green>Minijuegos automáticos activados."
        else if arg-1 is "off":
            set {-mg::activo} to false
            send "{@prefijo} <red>Minijuegos automáticos desactivados."
        else:
            send "<dark_gray><strikethrough>                                        "
            send " {@prefijo} <gray>Comandos"
            send "  <yellow>/mj iniciar [tipo] [recompensa] <dark_gray>» <gray>Lanza un juego"
            send "  <yellow>/mj stop <dark_gray>» <gray>Detiene el juego actual"
            send "  <yellow>/mj on|off <dark_gray>» <gray>Juegos automáticos (10 min)"
            send "  <gray>Tipos: <white>aleatorio, matematicas, suma, resta,"
            send "  <white>multiplicacion, division, palabra"
            send "  <dark_gray>Ej: /mj iniciar division 2500  |  /mj iniciar 1500"
            send "<dark_gray><strikethrough>                                        "

# ------------------------------------------------------------
#  Turno: no coincidir con otro anuncio automático (Skript o SunLight).
#  {-an::*} es compartido por todos los scripts de anuncios.
#  1020 = "Interval" de SunLight/modules/scheduler/announcers/global.yml
# ------------------------------------------------------------
function mgLibre() :: boolean:
    set {_t} to unix timestamp of now
    if {_t} - ({-an::ultimo} ? 0) < 300:
        return false
    set {_m} to mod({_t} - {-an::inicio}, 1020)
    if {_m} < 150:
        return false
    if {_m} > 1020 - 150:
        return false
    return true

function mgMarcar():
    set {-an::ultimo} to unix timestamp of now


on load:
    if {-an::inicio} is not set:
        set {-an::inicio} to unix timestamp of now
