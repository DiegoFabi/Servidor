# ============================================================
#  EVENTOS DE JEFE (sustituyen a los eventos de EliteMobs)
#  Globales y comunitarios: un solo evento a la vez, cerca de un
#  jugador al azar, anunciado a todo el servidor.
#  - Por tiempo: cada {@int_min}-{@int_max} min, según mundo, hora y bioma del jugador.
#  - Por acción: picar ciertos bloques, pescar o arar (probabilidad baja).
#  - Rastreo: botón en el chat -> barra (SkBee) con distancia, dirección y vida.
#  - Huida: si nadie le pega en {@huida} min, el jefe escapa sin dejar botín.
#  - Recompensas por daño: 1.º 2000, 2.º 1700, 3.º 1500, resto 1000.
#  Los jefes y sus poderes están en MythicMobs (packs/Elites/Mobs/jefes_eventos.yml).
#  Rendimiento: sin bucles si no hay evento; el bucle de rastreo solo recorre
#  a quienes rastrean; el sitio de aparición solo usa chunks ya cargados.
# ============================================================
options:
    int_min: 15
    int_max: 30
    huida: 10
    dist_min: 30
    dist_max: 110
    p: <gradient:#FF5C5C:#FFB347>☠ Evento</gradient> <dark_gray>»<reset>

# ---------- Registro de eventos (generado desde EliteMobs) ----------
# Por tiempo: "id|condición|nombre|jefes"   condición: normal, noche, nether, end, oceano, bioma:a,b
# Por acción: "id|tipo|probabilidad|bloques|nombre|jefes"
on load:
    delete {-ev::lista::*}
    delete {-ev::accion::*}
    delete {-ev::rompe::*}
    add "amonde|bioma:desert,badlands,eroded_badlands,wooded_badlands|Amonde, el Rey de Hueso|mm:skeleton_boss" to {-ev::lista::*}
    add "animated_armor|normal|Armadura Animada|animated_armor" to {-ev::lista::*}
    add "banshee|normal|Banshee|banshee" to {-ev::lista::*}
    add "beach_bug|bioma:beach,snowy_beach|Bicho de Playa|beach_bug" to {-ev::lista::*}
    add "beast_tamer|noche|Domador de Bestias|beast_tamer" to {-ev::lista::*}
    add "big_bad_wolf|nether|Lobo Feroz|big_bad_wolf" to {-ev::lista::*}
    add "bloated_jeffrey|nether|Jeffrey el Hinchado|bloated_jeffrey" to {-ev::lista::*}
    add "bone_fiend|noche|Demonio de Hueso|bone_fiend" to {-ev::lista::*}
    add "circus_ringmaster|noche|Maestro de Ceremonias|circus_ringmaster" to {-ev::lista::*}
    add "cursed_bandit|normal|Bandido Maldito|cursed_bandit" to {-ev::lista::*}
    add "divine_cinder|nether|Ceniza Divina|divine_cinder" to {-ev::lista::*}
    add "enders|end|Enderchico|enders_1,enders_2,enders_3" to {-ev::lista::*}
    add "endless_pursuer|nether|Perseguidor Eterno|endless_pursuer" to {-ev::lista::*}
    add "enraged_snowman|bioma:windswept_hills,windswept_gravelly_hills,snowy_plains,ice_spikes,snowy_taiga,snowy_beach,grove,snowy_slopes,jagged_peaks,frozen_peaks,frozen_river|Muñeco de Nieve Furioso|enraged_snowman" to {-ev::lista::*}
    add "fire_conjurer|noche|Conjurador de Fuego|fire_conjurer" to {-ev::lista::*}
    add "firestarter|normal|Incendiario|firestarter" to {-ev::lista::*}
    add "gremlin|normal|Gremlin|gremlin_1,gremlin_2,gremlin_3,gremlin_4,gremlin_5,gremlin_6,gremlin_7,gremlin_8,gremlin_9,gremlin_10" to {-ev::lista::*}
    add "jungle_lion|bioma:jungle,sparse_jungle,bamboo_jungle|León de la Selva|jungle_lion" to {-ev::lista::*}
    add "magi_giant|bioma:plains,desert,snowy_plains,badlands,meadow|Gigante Mago|giant_magi" to {-ev::lista::*}
    add "magma_construct|normal|Constructo de Magma|magma_construct" to {-ev::lista::*}
    add "moonlight_devourer|noche|Devorador Lunar|moonlight_devourer" to {-ev::lista::*}
    add "morgana|noche|Morgana|morgana" to {-ev::lista::*}
    add "mutated_mermaid|oceano|Sirena Mutada|mutated_mermaid" to {-ev::lista::*}
    add "nether_bovine|noche|Bovino Infernal|nether_bovine" to {-ev::lista::*}
    add "nether_hag|nether|Bruja del Nether|nether_hag" to {-ev::lista::*}
    add "nether_wasp|nether|Avispa Infernal|nether_wasp" to {-ev::lista::*}
    add "night_horder|noche|Acaparador Nocturno|night_horder" to {-ev::lista::*}
    add "rotting_diver|oceano|Buzo Podrido|rotting_diver" to {-ev::lista::*}
    add "sand_fiend|bioma:badlands,desert,beach|Demonio de Arena|sand_fiend,sand_fiend_1,sand_fiend_2" to {-ev::lista::*}
    add "skeleton_knight|noche|Caballero Esqueleto|skeleton_knight" to {-ev::lista::*}
    add "sky_archer|normal|Arquero del Cielo|sky_archer" to {-ev::lista::*}
    add "smallstack|noche|Pilacorta (Cima)|smallstack" to {-ev::lista::*}
    add "sorcerer_supreme|normal|Hechicero Supremo|sorcerer_supreme" to {-ev::lista::*}
    add "storm_caller|noche|Invocador de Tormentas|storm_caller" to {-ev::lista::*}
    add "suspicious_phantom|noche|Phantom Sospechoso|suspicious_phantom" to {-ev::lista::*}
    add "the_great_weaver|noche|La Gran Tejedora|the_great_weaver" to {-ev::lista::*}
    add "the_hunter|normal|El Cazador|the_hunter" to {-ev::lista::*}
    add "tiny_giant|normal|Gigante Diminuto|tiny_giant" to {-ev::lista::*}
    add "tree_trampler|bioma:birch_forest,old_growth_birch_forest,forest,dark_forest,wooded_badlands|Pisoteador|tree_trampler" to {-ev::lista::*}
    add "undead_farmer|noche|Granjero No Muerto|undead_farmer" to {-ev::lista::*}
    add "unwanted_visitor|nether|Visitante Indeseado|unwanted_visitor" to {-ev::lista::*}
    add "wandering_giant|bioma:plains,desert,snowy_plains,badlands,meadow|Gigante Errante|wandering_giant" to {-ev::lista::*}
    add "warlock|noche|Brujo|warlock" to {-ev::lista::*}
    add "ancient_corpse|BREAK_BLOCK|0.001|end stone|Cadáver Ancestral|ancient_corpse" to {-ev::accion::*}
    add "annoyed_drowned|FISH|0.001|-|Ahogado Furioso|annoyed_drowned" to {-ev::accion::*}
    add "bone_skeleton|BREAK_BLOCK|0.01|bone block|Esqueleto de Hueso|bone_skeleton" to {-ev::accion::*}
    add "earth_mite|BREAK_BLOCK|0.0001|grass block|Ácaro de Tierra|earth_mite" to {-ev::accion::*}
    add "ender_guardian|BREAK_BLOCK|0.005|obsidian,crying obsidian|Guardián del End|ender_guardian" to {-ev::accion::*}
    add "ender_lapin|BREAK_BLOCK|0.001|end stone|Conejo del End|ender_lapin" to {-ev::accion::*}
    add "exhumed_dead|BREAK_BLOCK|0.0001|deepslate|Muerto Exhumado|exhumed_dead" to {-ev::accion::*}
    add "starving_hog|TILL_SOIL|0.0001|-|Cerdo Hambriento|starving_hog" to {-ev::accion::*}
    loop {-ev::accion::*}:
        set {_d::*} to split loop-value at "|"
        if {_d::2} is "BREAK_BLOCK":
            loop split {_d::4} at ",":
                add loop-value-1 to {-ev::rompe::%loop-value-2%::*}

# ---------- Utilidades ----------
function evMundo(w: world) :: text:
    if "%{_w}%" is "survivalMain":
        return "normal"
    if "%{_w}%" is "world_nether":
        return "nether"
    if "%{_w}%" is "world_the_end":
        return "end"
    return "ninguno"

function evCondOk(p: player, c: text) :: boolean:
    set {_m} to evMundo(world of {_p})
    if {_c} is "nether" or "end":
        return true if {_m} is {_c} else false
    {_m} is "normal"
    if {_c} is "normal":
        return true
    if {_c} is "noche":
        if time in world of {_p} is between 19:00 and 23:59:
            return true
        if time in world of {_p} is between 0:00 and 5:00:
            return true
        return false
    set {_b} to "%biome at {_p}%"
    if {_c} is "oceano":
        return true if {_b} contains "ocean" else false
    if {_c} starts with "bioma:":
        replace all "bioma:" in {_c} with ""
        loop split {_c} at ",":
            replace all "_" in loop-value with " "
            if {_b} is loop-value:
                return true
    return false

# Busca un sitio en chunks YA cargados (no carga chunks en el hilo principal)
function evSitio(c: location) :: location:
    set {_m} to evMundo(world of {_c})
    loop 8 times:
        set {_a} to random number between 0 and 360
        set {_r} to random integer between {@dist_min} and {@dist_max}
        set {_l} to {_c} ~ vector(cos({_a}) * {_r}, 0, sin({_a}) * {_r})
        if chunk at {_l} is loaded:
            if {_m} is "nether":
                set {_l} to location(x-coordinate of {_l}, 32, z-coordinate of {_l}, world of {_c})
                loop 70 times:
                    if block at {_l} is solid:
                        if block above {_l} is air:
                            if block 2 meters above {_l} is air:
                                return {_l} ~ vector(0, 1, 0)
                    set {_l} to {_l} ~ vector(0, 1, 0)
            else:
                set {_h} to highest block at {_l}
                if y-coordinate of {_h} > 20:
                    return location of {_h} ~ vector(0.5, 1, 0.5)

function evNivel(l: location) :: integer:
    set {_m} to evMundo(world of {_l})
    set {_per} to 32
    if {_m} is "nether":
        set {_per} to 4
    if {_m} is "end":
        set {_per} to 24
    set {_d} to sqrt(x-coordinate of {_l} ^ 2 + z-coordinate of {_l} ^ 2)
    set {_n} to floor({_d} / {_per}) + random integer between 3 and 8
    return min(250, max(1, {_n}))

# ---------- Inicio ----------
function evIniciar(def: text, l: location, cerca: text):
    {-ev::activo} is not set
    set {_d::*} to split {_def} at "|"
    set {_nombre} to {_d::%size of {_d::*} - 1%}
    set {_jefes::*} to split {_d::%size of {_d::*}%} at ","
    set {_lvl} to evNivel({_l})
    set {-ev::activo} to {_d::1}
    set {-ev::nombre} to {_nombre}
    set {-ev::nivel} to {_lvl}
    set {-ev::loc} to {_l}
    set {-ev::inicio} to now
    set {-ev::golpe} to now
    set {-ev::vivos} to size of {_jefes::*}
    delete {-ev::dano::*}
    delete {-ev::nombrej::*}
    delete {-ev::huyendo}
    delete {-ev::boss}
    loop {_jefes::*}:
        set {_mob} to "jefe_%loop-value%"
        if loop-value starts with "mm:":
            set {_mob} to loop-value
            replace all "mm:" in {_mob} with ""
        execute console command "mm mobs spawn %{_mob}%:%{_lvl}% 1 %world of {_l}%,%rounded x-coordinate of {_l}%,%rounded y-coordinate of {_l}%,%rounded z-coordinate of {_l}%"
    set {_mundo} to "Supervivencia"
    if evMundo(world of {_l}) is "nether":
        set {_mundo} to "el Nether"
    if evMundo(world of {_l}) is "end":
        set {_mundo} to "el End"
    loop all players:
        send " " to loop-player
        send formatted "{@p} <#FFD36B><bold>%{_nombre}%</bold> <#7E848F>Nv %{_lvl}%" to loop-player
        send formatted "<#C9CDD6>   Ha aparecido %{_cerca}% en <white>%{_mundo}%</white>." to loop-player
        send formatted "<#C9CDD6>   Los 3 que más daño hagan se llevan la mejor recompensa." to loop-player
        send formatted "   <click:run_command:'/eventoelite rastrear'><hover:show_text:'<#7FD8FF>Muestra una barra con distancia, dirección y vida'><#7FD8FF>[⌖ Rastrear]</hover></click>  <click:run_command:'/eventoelite dejar'><hover:show_text:'<#9EA3AE>Quita la barra de rastreo'><#9EA3AE>[✖ Dejar de rastrear]</hover></click>" to loop-player
        send " " to loop-player
        play sound "block.bell.resonate" with volume 0.6 and pitch 0.8 to loop-player
        if world of loop-player is world of {_l}:
            if distance between loop-player and {_l} < 160:
                send title "<#FF5C5C>☠ %{_nombre}%" with subtitle "<#C9CDD6>ha aparecido cerca" to loop-player for 3 seconds
    wait 10 ticks
    evBuscarJefe()

function evBuscarJefe():
    {-ev::loc} is set
    chunk at {-ev::loc} is loaded
    loop all entities in radius 32 of {-ev::loc}:
        if loop-entity has scoreboard tag "elite_evento":
            set {-ev::boss} to loop-entity
            stop

# ---------- Final ----------
function evTerminar():
    loop {-ev::rastreo::*}:
        delete bossbar named "evr_%loop-index%"
    delete {-ev::rastreo::*}
    delete {-ev::activo}
    delete {-ev::boss}
    delete {-ev::loc}
    delete {-ev::dano::*}
    delete {-ev::nombrej::*}
    set {_min} to random integer between {@int_min} and {@int_max}
    set {-ev::proximo} to now
    add {_min} minutes to {-ev::proximo}

function evHuida():
    set {-ev::huyendo} to true
    if {-ev::loc} is set:
        if chunk at {-ev::loc} is loaded:
            loop all entities in radius 48 of {-ev::loc}:
                if loop-entity has scoreboard tag "elite_evento":
                    kill loop-entity
                else if loop-entity has scoreboard tag "elite_evento_esbirro":
                    kill loop-entity
    send formatted "{@p} <#FFB347>%{-ev::nombre}%</#FFB347> <#C9CDD6>se ha cansado de esperar y se desvanece entre las sombras. <#7E848F>({@huida} min sin recibir golpes)" to all players
    evTerminar()

function evVictoria():
    set {_t} to difference between {-ev::inicio} and now
    set {_total} to 0
    loop {-ev::dano::*}:
        add loop-value to {_total}
    set {_orden::*} to sorted indices of {-ev::dano::*} in descending order
    loop all players:
        send " " to loop-player
        send formatted "<gradient:#7FFF9E:#5CE1E6>✦ Evento superado</gradient> <dark_gray>» <#FFD36B><bold>%{-ev::nombre}%</bold> <#7E848F>(%{_t}%, %size of {_orden::*}% participantes)" to loop-player
    set {_i} to 0
    loop {_orden::*}:
        add 1 to {_i}
        set {_n} to {-ev::nombrej::%loop-value%}
        set {_pct} to round(100 * {-ev::dano::%loop-value%} / max({_total}, 1))
        set {_premio} to 1000
        if {_i} is 1:
            set {_premio} to 2000
            set {_linea} to "<#FFD36B>   1º %{_n}%"
        else if {_i} is 2:
            set {_premio} to 1700
            set {_linea} to "<#DADDE3>   2º %{_n}%"
        else if {_i} is 3:
            set {_premio} to 1500
            set {_linea} to "<#D49A6A>   3º %{_n}%"
        execute console command "eco give %{_n}% %{_premio}% -sf"
        if {_i} <= 3:
            set {_dmg} to round({-ev::dano::%loop-value%})
            send formatted "%{_linea}% <#7E848F>— %{_dmg}% de daño (%{_pct}%%%) <#7FFF9E>+%{_premio}% monedas" to all players
    if {_i} > 3:
        send formatted "<#7E848F>   El resto de participantes: <#7FFF9E>+1000 monedas" to all players
    send " " to all players
    evTerminar()

# ---------- Programador (1 comprobación por minuto, sin trabajo si hay evento) ----------
every 1 minute:
    {-ev::activo} is not set
    if {-ev::proximo} is not set:
        set {-ev::proximo} to now
        add {@int_min} minutes to {-ev::proximo}
        stop
    now > {-ev::proximo}
    loop all players:
        if gamemode of loop-player is survival:
            if evMundo(world of loop-player) is not "ninguno":
                add loop-player to {_cand::*}
    size of {_cand::*} > 0
    set {_p} to random element out of {_cand::*}
    loop {-ev::lista::*}:
        set {_d::*} to split loop-value at "|"
        if evCondOk({_p}, {_d::2}) is true:
            add loop-value to {_validos::*}
    size of {_validos::*} > 0
    set {_l} to evSitio(location of {_p})
    {_l} is set
    evIniciar(random element out of {_validos::*}, {_l}, "cerca de <white>%{_p}%</white>")

# ---------- Eventos por acción ----------
on break:
    {-ev::activo} is not set
    {-ev::rompe::%type of event-block%::*} is set
    evMundo(world of player) is not "ninguno"
    loop {-ev::rompe::%type of event-block%::*}:
        set {_d::*} to split loop-value at "|"
        set {_c} to ({_d::3} parsed as number) * 100
        if chance of {_c}%:
            evIniciar(loop-value, location of event-block, "donde <white>%player%</white> estaba picando")
            stop

on fishing state of caught fish:
    {-ev::activo} is not set
    evMundo(world of player) is not "ninguno"
    loop {-ev::accion::*}:
        set {_d::*} to split loop-value at "|"
        if {_d::2} is "FISH":
            set {_c} to ({_d::3} parsed as number) * 100
            if chance of {_c}%:
                evIniciar(loop-value, location of player, "mientras <white>%player%</white> pescaba")
                stop

on right click on dirt or grass block or dirt path:
    {-ev::activo} is not set
    "%type of player's tool%" contains "hoe"
    evMundo(world of player) is not "ninguno"
    loop {-ev::accion::*}:
        set {_d::*} to split loop-value at "|"
        if {_d::2} is "TILL_SOIL":
            set {_c} to ({_d::3} parsed as number) * 100
            if chance of {_c}%:
                evIniciar(loop-value, location of player, "mientras <white>%player%</white> araba la tierra")
                stop

# ---------- Daño, muerte y huida ----------
on damage:
    victim has scoreboard tag "elite_evento"
    attacker is a player
    set {-ev::boss} to victim
    set {-ev::golpe} to now
    add damage to {-ev::dano::%uuid of attacker%}
    set {-ev::nombrej::%uuid of attacker%} to name of attacker

on death:
    victim has scoreboard tag "elite_evento"
    if {-ev::huyendo} is true:
        clear drops
        set dropped experience to 0
        stop
    {-ev::activo} is set
    remove 1 from {-ev::vivos}
    {-ev::vivos} <= 0
    evVictoria()

# ---------- Rastreo (solo trabaja si alguien rastrea) ----------
every 2 seconds:
    {-ev::activo} is set
    if difference between {-ev::golpe} and now > {@huida} minutes:
        evHuida()
        stop
    if {-ev::boss} is not set:
        evBuscarJefe()
    else if {-ev::boss} is not valid:
        delete {-ev::boss}
        evBuscarJefe()
    if {-ev::boss} is set:
        set {-ev::loc} to location of {-ev::boss}
    {-ev::rastreo::*} is set
    set {_vida} to 100
    if {-ev::boss} is set:
        set {_vida} to 100 * health of {-ev::boss} / max health of {-ev::boss}
    set {_flechas::*} to "↑", "↗", "→", "↘", "↓", "↙", "←" and "↖"
    loop {-ev::rastreo::*}:
        set {_j} to loop-value
        if {_j} is online:
            set {_b} to bossbar named "evr_%loop-index%"
            if {_b} is not set:
                set {_b} to new bossbar with id "evr_%loop-index%" with title "<#FF5C5C>☠ <#FFD36B>%{-ev::nombre}%" with color red with style segmented_10 with progress 100
                add {_j} to bossbar players of {_b}
            if world of {_j} is not world of {-ev::loc}:
                set bossbar title of {_b} to "<#FF5C5C>☠ <#FFD36B>%{-ev::nombre}% <#7E848F>· en otro mundo"
            else:
                set {_dx} to x-coordinate of {-ev::loc} - x-coordinate of {_j}
                set {_dz} to z-coordinate of {-ev::loc} - z-coordinate of {_j}
                set {_rel} to atan2({_dx}, {_dz}) - 90 - yaw of {_j}
                set {_rel} to mod({_rel} + 540, 360) - 180
                set {_i} to mod(round({_rel} / 45), 8) + 1
                set {_dist} to round(distance between {_j} and {-ev::loc})
                set bossbar title of {_b} to "<#FF5C5C>☠ <#FFD36B>%{-ev::nombre}% <#7E848F>Nv %{-ev::nivel}% <dark_gray>· <white>a %{_dist}% bloques %{_flechas::%{_i}%}%"
            set bossbar progress of {_b} to {_vida}

command /eventoelite [<text>] [<text>]:
    trigger:
        if arg-1 is "rastrear":
            if {-ev::activo} is not set:
                send "{@p} <#C9CDD6>No hay ningún evento activo." to player
                stop
            set {_id} to "%uuid of player%"
            if {-ev::rastreo::%{_id}%} is set:
                stop
            set {-ev::rastreo::%{_id}%} to player
            set {_b} to new bossbar with id "evr_%{_id}%" with title "<#FF5C5C>☠ <#FFD36B>%{-ev::nombre}% <#7E848F>· buscando…" with color red with style segmented_10 with progress 100
            add player to bossbar players of {_b}
            send action bar "<#7FD8FF>⌖ <#C9CDD6>Rastreando a <#FFD36B>%{-ev::nombre}%" to player
        else if arg-1 is "dejar":
            set {_id} to "%uuid of player%"
            delete {-ev::rastreo::%{_id}%}
            delete bossbar named "evr_%{_id}%"
            send action bar "<#9EA3AE>✖ Rastreo desactivado" to player
        else if player has permission "servidor.eventos.admin":
            if arg-1 is "iniciar":
                loop {-ev::lista::*} and {-ev::accion::*}:
                    if loop-value starts with "%arg-2%|":
                        set {_l} to evSitio(location of player)
                        if {_l} is not set:
                            set {_l} to location of player
                        evIniciar(loop-value, {_l}, "cerca de <white>%player%</white>")
                        stop
                send "{@p} <#C9CDD6>Evento no encontrado (o ya hay uno activo)." to player
            else if arg-1 is "terminar":
                evHuida()
            else if arg-1 is "lista":
                send "{@p} <#C9CDD6>Activo: <white>%{-ev::activo} ? "ninguno"%</white> · Próximo: <white>%{-ev::proximo} ? "-"%" to player
                loop {-ev::lista::*} and {-ev::accion::*}:
                    set {_d::*} to split loop-value at "|"
                    add {_d::1} to {_ids::*}
                send "<#7E848F>%join {_ids::*} with ", "%" to player

on quit:
    set {_id} to "%uuid of player%"
    {-ev::rastreo::%{_id}%} is set
    delete {-ev::rastreo::%{_id}%}
    delete bossbar named "evr_%{_id}%"
