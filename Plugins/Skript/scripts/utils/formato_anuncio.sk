# ============================================================
#  formato_anuncio.sk - Formato común de los anuncios del chat
#
#  Mismo esqueleto que los anuncios de SunLight (imagen de referencia):
#
#      (línea en blanco)
#          — ⋄ Anuncios de ... ⋄ —        <- cabecera (color claro)
#               TÍTULO EN NEGRITA          <- título (color fuerte)
#      (línea en blanco)
#            líneas centradas
#      (línea en blanco)
#            ⋄ ¡Click para ...! ⋄          <- opcional
#      (línea en blanco)
#              ⟐ ᴄʟᴏᴜᴅꜱʙʟᴜᴇꜱ
#      (línea en blanco)
#
#  Cada sistema usa su propia paleta (no se repiten colores):
#    Anuncios SunLight  lila     #B8AAFF / #8E7CFF
#    Minijuegos chat    cian     #7FDCE6 / #3FD0DE
#    Coinflip           ámbar    #FFCF7A / #F5A623
#    Subastas           verde    #9BF0B5 / #3FCF7A
#    Ruleta (giro)      coral    #FFA58A / #F2643C
#      rosada  #FF9AE8 / #E040C0 · amarilla #FFF27A / #E8D020 · roja #FF8A8A / #E03E3E
#
#  Separación entre anuncios: anEsperarTurno() retrasa los anuncios
#  automáticos de Skript si hace poco salió otro o si está a punto de
#  salir uno de SunLight (Interval de announcers/global.yml).
# ============================================================

options:
    # Debe coincidir con "Interval" de SunLight/modules/scheduler/announcers/global.yml
    sunlight: 1020
    # Margen (s) alrededor de cada anuncio de SunLight
    margen-sunlight: 150
    # Mínimo (s) entre dos anuncios automáticos de Skript
    separacion: 300

on server start:
    set {-an::inicio} to unix timestamp of now

on load:
    if {-an::inicio} is not set:
        set {-an::inicio} to unix timestamp of now

# ------------------------------------------------------------
#  Centrado: calcula el ancho del texto sin etiquetas MiniMessage
# ------------------------------------------------------------
function anAncho(t: text) :: number:
    set {_w} to 0
    set {_tag} to false
    set {_bold} to false
    set {_nombre} to ""
    loop length of {_t} times:
        set {_c} to subtext of {_t} from characters loop-number to loop-number
        if {_tag} is true:
            # Lo que va entre comillas (texto de hover, comandos) no se ve
            if {_c} is "'" or """":
                if {_q} is not set:
                    set {_q} to {_c}
                else if {_q} is {_c}:
                    delete {_q}
            else if {_q} is set:
                set {_nombre} to {_nombre}
            else if {_c} is ">":
                set {_tag} to false
                if {_nombre} is "bold" or "b":
                    set {_bold} to true
                else if {_nombre} is "/bold" or "/b" or "reset":
                    set {_bold} to false
            else:
                set {_nombre} to "%{_nombre}%%{_c}%"
        else if {_c} is "<":
            set {_tag} to true
            set {_nombre} to ""
        else:
            add 5.6 to {_w}
            if {_bold} is true:
                add 1 to {_w}
    return {_w}

function anCentrar(t: text) :: text:
    set {_n} to rounded down ((320 - anAncho({_t})) / 8)
    set {_pad} to ""
    if {_n} > 0:
        loop {_n} times:
            set {_pad} to "%{_pad}% "
    return "%{_pad}%%{_t}%"

# ------------------------------------------------------------
#  Piezas del anuncio
# ------------------------------------------------------------
function anArriba(p: players, cabecera: text, titulo: text):
    send "" to {_p::*}
    send formatted anCentrar({_cabecera}) to {_p::*}
    send formatted anCentrar({_titulo}) to {_p::*}
    send "" to {_p::*}

function anLinea(p: players, t: text):
    send formatted anCentrar({_t}) to {_p::*}

function anAbajo(p: players):
    send "" to {_p::*}
    send "                               <#9EA3AE>⟐ ᴄʟᴏᴜᴅꜱʙʟᴜᴇꜱ" to {_p::*}
    send "" to {_p::*}

# ------------------------------------------------------------
#  Turnos: evita que salgan dos anuncios a la vez
# ------------------------------------------------------------
function anLibre() :: boolean:
    set {_t} to unix timestamp of now
    if {_t} - ({-an::ultimo} ? 0) < {@separacion}:
        return false
    set {_m} to mod({_t} - {-an::inicio}, {@sunlight})
    if {_m} < {@margen-sunlight}:
        return false
    if {_m} > {@sunlight} - {@margen-sunlight}:
        return false
    return true

function anMarcar():
    set {-an::ultimo} to unix timestamp of now

# Patrón para los "every" (las funciones con "wait" no bloquean a quien
# las llama, por eso la espera va en el propio evento):
#
#   every 29 minutes:
#       loop 20 times:
#           if anLibre() is true:
#               exit loop
#           wait 30 seconds
#       anMarcar()
#       ...anuncio...
