# ============================================================
#  perfil.sk - Abre "Mi Perfil" (menú de CoreTools panelProfile)
#  Abrir: /perfil (botón "Mi Perfil" del menú principal de CoreTools)
#
#  Antes de abrir guarda la armadura que lleva el jugador en variables
#  de CoreTools (Variables/perfil.yml): pf_casco, pf_pecho, pf_piernas,
#  pf_botas. Los botones dinámicos del menú muestran esa pieza o un
#  soporte de armadura si el hueco está vacío.
# ============================================================

function pfMaterial(i: item) :: text:
    if {_i} is air:
        return "armor_stand"
    set {_t} to "%type of {_i}%"
    replace all " " with "_" in {_t}
    return {_t}

function pfAbrir(p: player):
    set {_n} to name of {_p}
    execute console command "core-variables set pf_casco %pfMaterial(helmet of {_p})% %{_n}%"
    execute console command "core-variables set pf_pecho %pfMaterial(chestplate of {_p})% %{_n}%"
    execute console command "core-variables set pf_piernas %pfMaterial(leggings of {_p})% %{_n}%"
    execute console command "core-variables set pf_botas %pfMaterial(boots of {_p})% %{_n}%"
    wait 2 ticks
    execute console command "core-menu panelProfile %{_n}%"

command /perfil:
    aliases: /profile
    trigger:
        pfAbrir(player)
