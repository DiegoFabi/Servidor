true,"blockActionBarMessages":true,"page":"EvNhjbZhptoYLAl","type":"cinematic","_genericBlueprint":null},{"id":"hj1MTrdHsxPvrwD","name":"cap1_chamana_vision_otra_vez","criteria":[],"modifiers":[],"triggers":[],"blockChatMessages":true,"blockActionBarMessages":true,"page":"EvNhjbZhptoYLAl","type":"cinematic","_genericBlueprint":null},{"id":"pta4OKzpzVwIayh","name":"cap1_chamana_tras_vision","criteria":[],"modifiers":[{"fact":"wkkMxzwwM5hpA6e","operator":"=","value":1}],"triggers":["iGpW5B9G0xQLOry"],"speaker":"pVLqPb5cMpkON74","text":"¿Lo sentiste? Ella también te observa. Busca a <#9EE37D>Tobías</#9EE37D>, el granjero: no sobrevivirás ahí fuera con el estómago vacío.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"XKErhtRFKs2K9ff","name":"cap1_chamana_opciones","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"wkkMxzwwM5hpA6e","operator":"==","value":1}],"modifiers":[],"triggers":[],"speaker":"pVLqPb5cMpkON74","text":"Los ecos susurran tu nombre…","options":[{"text":"<#C38BFF>✦ Háblame de la raíz que vi","criteria":[{"fact":"5PBbnm3NliqNT1N","operator":"==","value":1},{"fact":"KPiLyCJNOKjip5B","operator":"==","value":0}],"modifiers":[],"triggers":["sR4W5ZjmCSDqSej"]},{"text":"<#C38BFF>✦ Comenzar el ritual","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":1},{"fact":"31dvf8k69S2ygED","operator":">=","value":20},{"fact":"p6Yw7gVNy4cQI0p","operator":">=","value":10},{"fact":"DKpbdCXg1Gteama","operator":">=","value":16}],"modifiers":[],"triggers":["EAhZ5BA680Dw13a"]},{"text":"Sobre el ritual…","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":1}],"modifiers":[],"triggers":["s1G8YBSu7v1qmaP"]},{"text":"<#C38BFF>✦ Purificar la tierra","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":10},{"fact":"kVXaZuF7OsWruKB","operator":">=","value":32}],"modifiers":[],"triggers":["8ViZrz1lciY56Pi"]},{"text":"Sobre la tierra enferma…","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":10}],"modifiers":[],"triggers":["CYsSVRCgTJ9dYpY"]},{"text":"<#C38BFF>✦ Partículas Místicas","criteria":[],"modifiers":[],"triggers":["OnLY4QHcFwXR1dz"]},{"text":"Quiero ver la visión otra vez","criteria":[],"modifiers":[],"triggers":["hj1MTrdHsxPvrwD"]},{"text":"¿Qué es realmente la Maleza?","criteria":[],"modifiers":[],"triggers":["1ZsgbDxtLVuT5HT"]}],"duration":1000,"type":"option","_genericBlueprint":null},{"id":"OnLY4QHcFwXR1dz","name":"cap1_chamana_abrir_particulas","criteria":[],"modifiers":[],"triggers":[],"command":"core-menu menuParticulas %player_name%","type":"console_run_command","_genericBlueprint":null},{"id":"1ZsgbDxtLVuT5HT","name":"cap1_chamana_lore","criteria":[],"modifiers":[],"triggers":[],"speaker":"pVLqPb5cMpkON74","text":"La Maleza no es una planta —es memoria. Se alimenta de lo que olvidamos. Por eso volvemos sin recuerdos… y por eso ella crece.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"WSFHvzafAVLkpuH","name":"cap1_granjero_interaccion","triggers":["5djgDrYoncgh4XL","otG5r6ssuwvRUsE"],"definition":"tSIOdSmdNHnccmy","shiftType":"ANY","interactionType":"RIGHT_CLICK","type":"entity_interact_event","_genericBlueprint":null},{"id":"ktw7bxVzeQBHZ2h","name":"cap1_granjero_saludo","criteria":[],"modifiers":[],"triggers":[],"entity":"ZonkP5GYIRkt5sr","animation":"wave","animationSettings":{"lerpIn":250,"lerpOut":250,"speed":1,"force":false,"priority":-1},"type":"play_modelengine_animation","_genericBlueprint":null},{"id":"SH5yUt2IYexHNdU","name":"cap1_granjero_sonido_saludo","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"entity.villager.celebrate"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.6,"pitch":1.2},"type":"play_sound","_genericBlueprint":null},{"id":"fol1P3q0QvplGLk","name":"cap1_granjero_opciones","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"EfujfoRnxa6wHW3","operator":"==","value":1}],"modifiers":[],"triggers":[],"speaker":"tSIOdSmdNHnccmy","text":"¿Qué te llevas hoy?","options":[{"text":"<#9EE37D>✦ Provisiones para la cripta","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":5},{"fact":"09ppDnGgR4cp1En","operator":"==","value":0}],"modifiers":[],"triggers":["LF28bYhdxj5g6Gx"]},{"text":"<#9EE37D>✦ ¿Qué le pasa a los campos?","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":8}],"modifiers":[],"triggers":["GuGOOaxivVQODYS"]},{"text":"<#9EE37D>✦ Entregar la cosecha","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":9},{"fact":"zBmo3uNgvc5bgBz","operator":">=","value":64},{"fact":"e5TapQTEXH1bogz","operator":">=","value":12}],"modifiers":[],"triggers":["1rkYED8z7IE4Y40"]},{"text":"Sobre la cosecha…","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":9}],"modifiers":[],"triggers":["7yEuTZ0Zo1OsJZW"]},{"text":"<#7FD8FF>✦ Entregar 10 diamantes","criteria":[{"fact":"0lR8acRYSi4MDF8","operator":"==","value":1},{"fact":"kWCBX1KpeZUaLJ4","operator":">=","value":10}],"modifiers":[],"triggers":["uLfafi1JrpRWBJG"]},{"text":"Sobre los diamantes…","criteria":[{"fact":"0lR8acRYSi4MDF8","operator":"==","value":1},{"fact":"kWCBX1KpeZUaLJ4","operator":"<","value":10}],"modifiers":[],"triggers":["9encC4davDsREym"]},{"text":"¿Necesitas ayuda con algo?","criteria":[{"fact":"0lR8acRYSi4MDF8","operator":"==","value":0}],"modifiers":[],"triggers":["LRqrxZKiGvbtcj7"]},{"text":"<#9EE37D>☀ Abrir la Tienda","criteria":[],"modifiers":[],"triggers":["n6l7TrKLR9n8eLh"]},{"text":"¿Qué le pasa a la cosecha?","criteria":[],"modifiers":[],"triggers":["M0d88n4W0JZloSi"]},{"text":"¿Algún consejo?","criteria":[],"modifiers":[],"triggers":["ATDXRw0Fr8K7wUO"]}],"duration":1000,"type":"option","_genericBlueprint":null},{"id":"otG5r6ssuwvRUsE","name":"cap1_granjero_no_te_conozco","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":5}],"modifiers":[],"triggers":[],"message":"<#FFB347>✦ <#C9CDD6>«No te conozco…» <#9EA3AE>Termina el tutorial primero","type":"action_bar_simple_message","_genericBlueprint":null},{"id":"A2V4MBvAfAsdj4Z","name":"cap1_granjero_presentacion_1","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"EfujfoRnxa6wHW3","operator":"==","value":0},{"fact":"8HlrwYMfvea9lkx","operator":"==","value":1},{"fact":"wkkMxzwwM5hpA6e","operator":"==","value":1}],"modifiers":[],"triggers":["zXqcBchyM12iyuA"],"speaker":"tSIOdSmdNHnccmy","text":"¡Ahá! Ya decía yo que esa cara me sonaba: Malvor dijo que vendrías. Se te nota en las botas, todavía están limpias.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"zXqcBchyM12iyuA","name":"cap1_granjero_presentacion_2","criteria":[],"modifiers":[],"triggers":["Obq9eRDtILwIWvr"],"speaker":"tSIOdSmdNHnccmy","text":"Soy Tobías. Vendo lo poco que la tierra aún quiere dar: comida, semillas y algo de equipo que me dejan los que no volvieron.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"Obq9eRDtILwIWvr","name":"cap1_granjero_presentacion_3","criteria":[],"modifiers":[{"fact":"EfujfoRnxa6wHW3","operator":"=","value":1}],"triggers":["dHsauE5iylGiFpF","3NV1FOQq6obbndy","LRqrxZKiGvbtcj7"],"speaker":"tSIOdSmdNHnccmy","text":"Pásate cuando quieras. Los precios son justos —bueno, casi siempre.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"n6l7TrKLR9n8eLh","name":"cap1_granjero_abrir_tienda","criteria":[],"modifiers":[],"triggers":[],"command":"core-menu MainShop %player_name%","type":"console_run_command","_genericBlueprint":null},{"id":"M0d88n4W0JZloSi","name":"cap1_granjero_lore","criteria":[],"modifiers":[],"triggers":[],"speaker":"tSIOdSmdNHnccmy","text":"Antes la cosecha llegaba hasta el castillo. Ahora el trigo crece torcido, como si buscara algo bajo la tierra. Yo solo siembro donde ella no mira.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"ATDXRw0Fr8K7wUO","name":"cap1_granjero_consejo","criteria":[],"modifiers":[],"triggers":[],"speaker":"tSIOdSmdNHnccmy","text":"Nunca salgas sin comida. Morir de hambre es la forma más tonta de revivir, créeme… lo he visto demasiadas veces.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"dHsauE5iylGiFpF","name":"cap1_granjero_semillas","criteria":[],"modifiers":[],"triggers":[],"location":{"enabled":true,"value":{"world":"Lobby","x":59.5,"y":-20.0,"z":13.5,"yaw":90,"pitch":0.0}},"particle":"HAPPY_VILLAGER","count":12,"offset":{"x":0.6,"y":0.6,"z":0.6},"speed":0.02,"type":"spawn_particles","_genericBlueprint":null},{"id":"3NV1FOQq6obbndy","name":"cap1_granjero_campo","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"block.crop.break"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.8,"pitch":1.2},"type":"play_sound","_genericBlueprint":null},{"id":"WK59PFkl0JfI2yy","name":"cap1_herrero_mirar_al_npc","triggers":[],"interruptTriggers":[],"radius":5,"npc":null,"type":"look_at_entity_interaction_bound","_genericBlueprint":null},{"id":"VlbPegBPrUhRZds","name":"cap1_chamana_mirar_al_npc","triggers":[],"interruptTriggers":[],"radius":5,"npc":null,"type":"look_at_entity_interaction_bound","_genericBlueprint":null},{"id":"vDQuc8dWrdE03WK","name":"cap1_granjero_mirar_al_npc","triggers":[],"interruptTriggers":[],"radius":5,"npc":null,"type":"look_at_entity_interaction_bound","_genericBlueprint":null},{"id":"d8jOCs4bWYTI6wL","name":"cap1_granjero_titulo_mision","criteria":[],"modifiers":[],"triggers":[],"title":"<#9EE37D>Nueva Misión","subtitle":"<#C9CDD6>Consigue 10 diamantes","durations":{"enabled":true,"value":{"fadeIn":400,"stay":2600,"fadeOut":600}},"type":"show_title","_genericBlueprint":null},{"id":"qeeHq1PkCJVuoYq","name":"cap1_granjero_sonido_mision","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"block.note_block.bell"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.8,"pitch":1.2},"type":"play_sound","_genericBlueprint":null},{"id":"LRqrxZKiGvbtcj7","name":"cap1_granjero_mision_oferta","criteria":[],"modifiers":[{"fact":"0lR8acRYSi4MDF8","operator":"=","value":1}],"triggers":["d8jOCs4bWYTI6wL","qeeHq1PkCJVuoYq"],"speaker":"tSIOdSmdNHnccmy","text":"Pero antes de venderte nada —necesito un favor. La Maleza pudrió mis herramientas y sin buen acero no hay cosecha. Tráeme <#7FD8FF>10 diamantes</#7FD8FF> y te pagaré bien, con comida caliente incluida.","duration":1800,"type":"spoken","_genericBlueprint":null},{"id":"bsHXDYzEzVMGPBn","name":"cap1_granjero_quitar_diamantes","criteria":[],"modifiers":[],"triggers":[],"item":{"case":"custom_item","value":{"components":[{"case":"material","value":{"material":"DIAMOND"}},{"case":"amount","value":{"amount":10}}]}},"type":"remove_item","_genericBlueprint":null},{"id":"u3mY2lhm12FPzmV","name":"cap1_granjero_pago","criteria":[],"modifiers":[],"triggers":[],"amount":2500.0,"type":"deposit_balance","_genericBlueprint":null},{"id":"4eAk5M7ByFgDcEW","name":"cap1_granjero_comida","criteria":[],"modifiers":[],"triggers":[],"item":{"case":"custom_item","value":{"components":[{"case":"material","value":{"material":"COOKED_BEEF"}},{"case":"amount","value":{"amount":32}}]}},"type":"give_item","_genericBlueprint":null},{"id":"7AKW3gc3FnJxFkQ","name":"cap1_granjero_titulo_entrega","criteria":[],"modifiers":[],"triggers":[],"title":"<#FFD36B>Misión Completada","subtitle":"<#7FFF9E>+2500 Monedas <dark_gray>• <#FFB347>32 Filetes","durations":{"enabled":true,"value":{"fadeIn":400,"stay":2600,"fadeOut":600}},"type":"show_title","_genericBlueprint":null},{"id":"jVDZRucq2zyw8GO","name":"cap1_granjero_sonido_entrega","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"entity.villager.celebrate"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.9,"pitch":1.0},"type":"play_sound","_genericBlueprint":null},{"id":"uLfafi1JrpRWBJG","name":"cap1_granjero_mision_entrega","criteria":[],"modifiers":[{"fact":"0lR8acRYSi4MDF8","operator":"=","value":2}],"triggers":["bsHXDYzEzVMGPBn","u3mY2lhm12FPzmV","4eAk5M7ByFgDcEW","7AKW3gc3FnJxFkQ","jVDZRucq2zyw8GO","iGpW5B9G0xQLOry"],"speaker":"tSIOdSmdNHnccmy","text":"¡Diez! Brillan como el sol —ese que ya no vemos. Toma tus monedas y algo de comida caliente: ahí fuera vas a necesitarla. Ahora sí, mi tienda es tu tienda.","duration":1800,"type":"spoken","_genericBlueprint":null},{"id":"9encC4davDsREym","name":"cap1_granjero_mision_recordatorio","criteria":[],"modifiers":[],"triggers":[],"speaker":"tSIOdSmdNHnccmy","text":"Todavía no. Necesito <#7FD8FF>10 diamantes</#7FD8FF> y llevas <#7FD8FF>%typewriter_kWCBX1KpeZUaLJ4%</#7FD8FF>. Baja a las profundidades: entre la capa -50 y -60 es donde más brillan.","duration":1800,"type":"spoken","_genericBlueprint":null},{"id":"CXkGKEqHOJsDztK","name":"cap1_herrero_fuera_tutorial","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":1},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":2},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":3},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":4},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":6}],"modifiers":[],"triggers":["0BFn7BwpkZ01BZG","Cl5ov9RttYnn1sC","IvaUojhbOIDYvGm","9pyaA6juCAGLlEc","Z4qTOWIsYy2e2Cn","WK59PFkl0JfI2yy","ujYimKsT7nv4ur3"],"type":"simple_action","_genericBlueprint":null},{"id":"X7qTZcapnFy99dd","name":"cap1_chamana_fuera_tutorial","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":1},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":2},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":3},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":4},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":6}],"modifiers":[],"triggers":["0BFn7BwpkZ01BZG","TAA14vdnc2lOch8","46IC4ZulAqpNx9D","HG6HioLgyHSdPr4","Pyx8ZuTAVE14vtV","XKErhtRFKs2K9ff","VlbPegBPrUhRZds","pRPQ2CmfjASSGnw","cxsOsFg7fbGKZu7"],"type":"simple_action","_genericBlueprint":null},{"id":"5djgDrYoncgh4XL","name":"cap1_granjero_fuera_tutorial","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":1},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":2},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":3},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":4},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":6}],"modifiers":[],"triggers":["0BFn7BwpkZ01BZG","ktw7bxVzeQBHZ2h","SH5yUt2IYexHNdU","A2V4MBvAfAsdj4Z","fol1P3q0QvplGLk","vDQuc8dWrdE03WK","UHI7PyJdHitjIbm","9JqzopIoSA0UqUO","3wmZ2uPETUW1Ajm"],"type":"simple_action","_genericBlueprint":null},{"id":"pRPQ2CmfjASSGnw","name":"cap1_chamana_aun_no","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"8HlrwYMfvea9lkx","operator":"==","value":0},{"fact":"wkkMxzwwM5hpA6e","operator":"==","value":0}],"modifiers":[],"triggers":[],"speaker":"pVLqPb5cMpkON74","text":"Mmm… tu rostro me resulta familiar, como un eco que aún no termina de sonar. Ve primero con <#FFB347>Brom</#FFB347>, en la forja; los ecos llegan en orden.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"UHI7PyJdHitjIbm","name":"cap1_granjero_aun_no_herrero","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"8HlrwYMfvea9lkx","operator":"==","value":0},{"fact":"EfujfoRnxa6wHW3","operator":"==","value":0}],"modifiers":[],"triggers":[],"speaker":"tSIOdSmdNHnccmy","text":"¿Nos conocemos? Me suenas de algún lado… no, todavía no caigo. Habla con <#FFB347>Brom</#FFB347>, el herrero; él recibe a los que vuelven.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"9JqzopIoSA0UqUO","name":"cap1_granjero_aun_no_chamana","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"8HlrwYMfvea9lkx","operator":"==","value":1},{"fact":"wkkMxzwwM5hpA6e","operator":"==","value":0},{"fact":"EfujfoRnxa6wHW3","operator":"==","value":0}],"modifiers":[],"triggers":[],"speaker":"tSIOdSmdNHnccmy","text":"Esa cara… juraría que la he visto antes. <#C38BFF>Malvor</#C38BFF> anda preguntando por alguien como tú; ve con ella primero.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"ujYimKsT7nv4ur3","name":"cap1_herrero_saludo_turno","criteria":[],"modifiers":[],"triggers":[],"entity":"Su86mjkNk9eT3kz","animation":"wave","animationSettings":{"lerpIn":250,"lerpOut":250,"speed":1,"force":false,"priority":-1},"type":"play_modelengine_animation","_genericBlueprint":null},{"id":"cxsOsFg7fbGKZu7","name":"cap1_chamana_saludo_turno","criteria":[],"modifiers":[],"triggers":[],"entity":"gXWxzK47g61Py0V","animation":"wave","animationSettings":{"lerpIn":250,"lerpOut":250,"speed":1,"force":false,"priority":-1},"type":"play_modelengine_animation","_genericBlueprint":null},{"id":"3wmZ2uPETUW1Ajm","name":"cap1_granjero_saludo_turno","criteria":[],"modifiers":[],"triggers":[],"entity":"E0XVbjjPijo7rUD","animation":"wave","animationSettings":{"lerpIn":250,"lerpOut":250,"speed":1,"force":false,"priority":-1},"type":"play_modelengine_animation","_genericBlueprint":null}],"chapter":"lore.capitulo1","priority":0,"version":"0.8.0"}