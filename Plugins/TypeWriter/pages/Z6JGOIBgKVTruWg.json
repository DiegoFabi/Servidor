iers":[],"triggers":[],"entity":"E7R5IiAWNKTJiHX","animation":"wave","animationSettings":{"lerpIn":250,"lerpOut":250,"speed":1,"force":false,"priority":-1},"type":"play_modelengine_animation","_genericBlueprint":null},{"id":"IvaUojhbOIDYvGm","name":"cap1_herrero_sonido_saludo","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"block.anvil.place"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.6,"pitch":1.2},"type":"play_sound","_genericBlueprint":null},{"id":"Z4qTOWIsYy2e2Cn","name":"cap1_herrero_opciones","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"8HlrwYMfvea9lkx","operator":"==","value":1}],"modifiers":[],"triggers":[],"speaker":"8t7mqaKzxEZUtub","text":"El yunque no espera. ¿Qué necesitas?","options":[{"text":"<#FFB347>⚒ Abrir la Herrería","criteria":[],"modifiers":[],"triggers":["7eJZXwoR4JuqsdM"]},{"text":"¿Qué hay más allá de los muros?","criteria":[],"modifiers":[],"triggers":["fr1gK3mqFhtVbE6"]},{"text":"¿Qué le pasó a tu clan?","criteria":[],"modifiers":[],"triggers":["fI4BRDcrD77MuBV"]},{"text":"¿Algún consejo?","criteria":[],"modifiers":[],"triggers":["hexlhHNPZDj004b"]}],"duration":1000,"type":"option","_genericBlueprint":null},{"id":"dO67MbO63ZJzqk5","name":"cap1_herrero_no_te_conozco","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":5}],"modifiers":[],"triggers":[],"message":"<#FFB347>Bram <dark_gray>» <#C9CDD6>*Sigue martilleando sin levantar la vista.* Ahora no, que se me enfría el hierro.","type":"action_bar_simple_message","_genericBlueprint":null},{"id":"9pyaA6juCAGLlEc","name":"cap1_herrero_presentacion_1","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"8HlrwYMfvea9lkx","operator":"==","value":0}],"modifiers":[],"triggers":["lE4Ivwpm1eUArqs"],"speaker":"8t7mqaKzxEZUtub","text":"¡Eh, tú! Eres el forastero del que habla todo el reino, ¿no? Llegaste sin nada y con cara de no saber ni dónde estás.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"lE4Ivwpm1eUArqs","name":"cap1_herrero_presentacion_2","criteria":[],"modifiers":[],"triggers":["jTaDjgzdWu252SY"],"speaker":"8t7mqaKzxEZUtub","text":"Soy <#FFB347>Bram</#FFB347>, la herrera del reino. Aquí funciona así: tú traes minerales del mundo y yo los convierto en algo que te mantenga con vida.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"jTaDjgzdWu252SY","name":"cap1_herrero_presentacion_3","criteria":[],"modifiers":[{"fact":"8HlrwYMfvea9lkx","operator":"=","value":1}],"triggers":["Fx0pOGHg9TBsg3u","hZQzsWPdwIaqZsF","pJEmNwzsXFL41Ew","Z4qTOWIsYy2e2Cn","iGpW5B9G0xQLOry"],"speaker":"8t7mqaKzxEZUtub","text":"Ahora ve con <#C38BFF>Malvor</#C38BFF>, el chamán. Él ve lo que los demás no vemos y sabrá decirte por qué estás aquí.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"7eJZXwoR4JuqsdM","name":"cap1_herrero_abrir_herreria","criteria":[],"modifiers":[],"triggers":[],"command":"core-menu menuHerrero %player_name%","type":"console_run_command","_genericBlueprint":null},{"id":"fI4BRDcrD77MuBV","name":"cap1_herrero_lore","criteria":[],"modifiers":[],"triggers":[],"speaker":"8t7mqaKzxEZUtub","text":"Mi clan forjó la corona del Rey. Cuando cayó el Imperio, las minas del norte se llenaron de monstruos y tuvimos que huir. Solo quedo yo… y esta forja.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"hexlhHNPZDj004b","name":"cap1_herrero_consejo","criteria":[],"modifiers":[],"triggers":[],"speaker":"8t7mqaKzxEZUtub","text":"La piedra no te salvará mucho tiempo. Baja a las cuevas, busca hierro y tráemelo: con buen acero, este mundo da menos miedo.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"Fx0pOGHg9TBsg3u","name":"cap1_herrero_chispas","criteria":[],"modifiers":[],"triggers":[],"location":{"enabled":true,"value":{"world":"Lobby","x":-49.5,"y":26.2,"z":-37.5,"yaw":90,"pitch":0.0}},"particle":"LAVA","count":8,"offset":{"x":0.4,"y":0.4,"z":0.4},"speed":0.05,"type":"spawn_particles","_genericBlueprint":null},{"id":"hZQzsWPdwIaqZsF","name":"cap1_herrero_humo","criteria":[],"modifiers":[],"triggers":[],"location":{"enabled":true,"value":{"world":"Lobby","x":-49.5,"y":26.5,"z":-37.5,"yaw":90,"pitch":0.0}},"particle":"LARGE_SMOKE","count":10,"offset":{"x":0.3,"y":0.3,"z":0.3},"speed":0.02,"type":"spawn_particles","_genericBlueprint":null},{"id":"pJEmNwzsXFL41Ew","name":"cap1_herrero_yunque","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"block.anvil.use"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.7,"pitch":0.8},"type":"play_sound","_genericBlueprint":null},{"id":"TJwwzZHhN8vzLw5","name":"cap1_chamana_interaccion","triggers":["X7qTZcapnFy99dd","WyMx1OtUz6QW3hq"],"definition":"pVLqPb5cMpkON74","shiftType":"ANY","interactionType":"ALL","type":"entity_interact_event","_genericBlueprint":null},{"id":"TAA14vdnc2lOch8","name":"cap1_chamana_saludo","criteria":[],"modifiers":[],"triggers":[],"entity":"U4YD4MKVhEUFM6T","animation":"wave","animationSettings":{"lerpIn":250,"lerpOut":250,"speed":1,"force":false,"priority":-1},"type":"play_modelengine_animation","_genericBlueprint":null},{"id":"46IC4ZulAqpNx9D","name":"cap1_chamana_sonido_saludo","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"block.amethyst_block.chime"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.8,"pitch":0.8},"type":"play_sound","_genericBlueprint":null},{"id":"HG6HioLgyHSdPr4","name":"cap1_chamana_brillo","criteria":[],"modifiers":[],"triggers":[],"location":{"enabled":true,"value":{"world":"Lobby","x":-23.5,"y":25.6,"z":-2.5,"yaw":90,"pitch":0.0}},"particle":"WITCH","count":15,"offset":{"x":0.5,"y":0.5,"z":0.5},"speed":0.05,"type":"spawn_particles","_genericBlueprint":null},{"id":"WyMx1OtUz6QW3hq","name":"cap1_chamana_no_te_conozco","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":5}],"modifiers":[],"triggers":[],"message":"<#C38BFF>Malvor <dark_gray>» <#C9CDD6>*Murmura algo entre el humo del incienso.* Todavía no… los ecos aún no han hablado de ti.","type":"action_bar_simple_message","_genericBlueprint":null},{"id":"Pyx8ZuTAVE14vtV","name":"cap1_chamana_presentacion_1","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"wkkMxzwwM5hpA6e","operator":"==","value":0},{"fact":"8HlrwYMfvea9lkx","operator":"==","value":1}],"modifiers":[],"triggers":["DVS35PnmbjUPULn"],"speaker":"pVLqPb5cMpkON74","text":"¡Ah! Bram me habló de ti, el forastero. Hay algo extraño en tu alma… brilla distinto, como si no perteneciera a este lugar.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"DVS35PnmbjUPULn","name":"cap1_chamana_presentacion_2","criteria":[],"modifiers":[],"triggers":["43vh7yViqWEPPli"],"speaker":"pVLqPb5cMpkON74","text":"Soy <#C38BFF>Malvor</#C38BFF>, el chamán del reino. Puedo ver lo que esconden las almas… y la tuya esconde algo. Mira esto, no apartes la vista.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"43vh7yViqWEPPli","name":"cap1_chamana_vision","criteria":[],"modifiers":[],"triggers":["pta4OKzpzVwIayh"],"blockChatMessages":true,"blockActionBarMessages":true,"page":"EvNhjbZhptoYLAl","type":"cinematic","_genericBlueprint":null},{"id":"hj1MTrdHsxPvrwD","name":"cap1_chamana_vision_otra_vez","criteria":[],"modifiers":[],"triggers":[],"blockChatMessages":true,"blockActionBarMessages":true,"page":"EvNhjbZhptoYLAl","type":"cinematic","_genericBlueprint":null},{"id":"pta4OKzpzVwIayh","name":"cap1_chamana_tras_vision","criteria":[],"modifiers":[{"fact":"wkkMxzwwM5hpA6e","operator":"=","value":1}],"triggers":["iGpW5B9G0xQLOry"],"speaker":"pVLqPb5cMpkON74","text":"¿Lo sentiste? Este mundo te llamó. No despertaste aquí por azar: algo en el reino te necesitaba y te trajo desde muy lejos. Aún no sabemos para qué. Antes de nada, ve con <#9EE37D>Tobías</#9EE37D>, el granjero: él te enseñará a sobrevivir aquí.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"XKErhtRFKs2K9ff","name":"cap1_chamana_opciones","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"wkkMxzwwM5hpA6e","operator":"==","value":1}],"modifiers":[],"triggers":[],"speaker":"pVLqPb5cMpkON74","text":"Tu alma sigue brillando distinto…","options":[{"text":"<#C38BFF>✦ Partículas Místicas","criteria":[],"modifiers":[],"triggers":["OnLY4QHcFwXR1dz"]},{"text":"Quiero ver la visión otra vez","criteria":[],"modifiers":[],"triggers":["hj1MTrdHsxPvrwD"]},{"text":"¿Por qué estoy aquí?","criteria":[],"modifiers":[],"triggers":["1ZsgbDxtLVuT5HT"]}],"duration":1000,"type":"option","_genericBlueprint":null},{"id":"OnLY4QHcFwXR1dz","name":"cap1_chamana_abrir_particulas","criteria":[],"modifiers":[],"triggers":[],"command":"core-menu menuParticulas %player_name%","type":"console_run_command","_genericBlueprint":null},{"id":"1ZsgbDxtLVuT5HT","name":"cap1_chamana_lore","criteria":[],"modifiers":[],"triggers":[],"speaker":"pVLqPb5cMpkON74","text":"Las almas que llegan de otros mundos son pocas, y cada una trae un propósito. El reino lleva años esperando a alguien como tú. Cuando estés listo, el camino se mostrará solo.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"WSFHvzafAVLkpuH","name":"cap1_granjero_interaccion","triggers":["5djgDrYoncgh4XL","otG5r6ssuwvRUsE"],"definition":"tSIOdSmdNHnccmy","shiftType":"ANY","interactionType":"ALL","type":"entity_interact_event","_genericBlueprint":null},{"id":"ktw7bxVzeQBHZ2h","name":"cap1_granjero_saludo","criteria":[],"modifiers":[],"triggers":[],"entity":"ZonkP5GYIRkt5sr","animation":"wave","animationSettings":{"lerpIn":250,"lerpOut":250,"speed":1,"force":false,"priority":-1},"type":"play_modelengine_animation","_genericBlueprint":null},{"id":"SH5yUt2IYexHNdU","name":"cap1_granjero_sonido_saludo","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"entity.villager.celebrate"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.6,"pitch":1.2},"type":"play_sound","_genericBlueprint":null},{"id":"fol1P3q0QvplGLk","name":"cap1_granjero_opciones","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"EfujfoRnxa6wHW3","operator":"==","value":1}],"modifiers":[],"triggers":[],"speaker":"tSIOdSmdNHnccmy","text":"¿Qué te llevas hoy?","options":[{"text":"<#7FD8FF>✦ Entregar 10 diamantes","criteria":[{"fact":"0lR8acRYSi4MDF8","operator":"==","value":1},{"fact":"kWCBX1KpeZUaLJ4","operator":">=","value":10}],"modifiers":[],"triggers":["uLfafi1JrpRWBJG"]},{"text":"Sobre los diamantes…","criteria":[{"fact":"0lR8acRYSi4MDF8","operator":"==","value":1},{"fact":"kWCBX1KpeZUaLJ4","operator":"<","value":10}],"modifiers":[],"triggers":["9encC4davDsREym"]},{"text":"¿Necesitas ayuda con algo?","criteria":[{"fact":"0lR8acRYSi4MDF8","operator":"==","value":0}],"modifiers":[],"triggers":["LRqrxZKiGvbtcj7"]},{"text":"<#9EE37D>☀ Abrir la Tienda","criteria":[],"modifiers":[],"triggers":["n6l7TrKLR9n8eLh"]},{"text":"¿Qué le pasa a la cosecha?","criteria":[],"modifiers":[],"triggers":["M0d88n4W0JZloSi"]},{"text":"¿Algún consejo?","criteria":[],"modifiers":[],"triggers":["ATDXRw0Fr8K7wUO"]}],"duration":1000,"type":"option","_genericBlueprint":null},{"id":"otG5r6ssuwvRUsE","name":"cap1_granjero_no_te_conozco","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":5}],"modifiers":[],"triggers":[],"message":"<#9EE37D>Tobías <dark_gray>» <#C9CDD6>*Se limpia la frente y sigue arando.* Mucho trabajo hoy, forastero. Otro día charlamos.","type":"action_bar_simple_message","_genericBlueprint":null},{"id":"A2V4MBvAfAsdj4Z","name":"cap1_granjero_presentacion_1","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"EfujfoRnxa6wHW3","operator":"==","value":0},{"fact":"8HlrwYMfvea9lkx","operator":"==","value":1},{"fact":"wkkMxzwwM5hpA6e","operator":"==","value":1}],"modifiers":[],"triggers":["zXqcBchyM12iyuA"],"speaker":"tSIOdSmdNHnccmy","text":"¡Ah, eres tú, el forastero! Malvor me dijo que vendrías.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"zXqcBchyM12iyuA","name":"cap1_granjero_presentacion_2","criteria":[],"modifiers":[],"triggers":["Obq9eRDtILwIWvr"],"speaker":"tSIOdSmdNHnccmy","text":"Soy <#9EE37D>Tobías</#9EE37D>, el granjero. Aquí todo se paga con monedas: vendo comida, semillas y algo de equipo, y te compro lo que traigas del mundo.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"Obq9eRDtILwIWvr","name":"cap1_granjero_presentacion_3","criteria":[],"modifiers":[{"fact":"EfujfoRnxa6wHW3","operator":"=","value":1}],"triggers":["dHsauE5iylGiFpF","3NV1FOQq6obbndy","LRqrxZKiGvbtcj7"],"speaker":"tSIOdSmdNHnccmy","text":"Consejo de granjero: de día se trabaja y de noche uno se esconde, que los muertos salen cuando cae el sol. Pásate cuando quieras.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"n6l7TrKLR9n8eLh","name":"cap1_granjero_abrir_tienda","criteria":[],"modifiers":[],"triggers":[],"command":"core-menu MainShop %player_name%","type":"console_run_command","_genericBlueprint":null},{"id":"M0d88n4W0JZloSi","name":"cap1_granjero_lore","criteria":[],"modifiers":[],"triggers":[],"speaker":"tSIOdSmdNHnccmy","text":"Antes la cosecha llegaba hasta el castillo. Desde que cayó el Imperio, los monstruos rondan los campos y cada año hay menos que repartir.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"ATDXRw0Fr8K7wUO","name":"cap1_granjero_consejo","criteria":[],"modifiers":[],"triggers":[],"speaker":"tSIOdSmdNHnccmy","text":"Nunca salgas sin comida. Con el estómago vacío no corres, no te curas y no piensas. Lo he visto demasiadas veces.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"dHsauE5iylGiFpF","name":"cap1_granjero_semillas","criteria":[],"modifiers":[],"triggers":[],"location":{"enabled":true,"value":{"world":"Lobby","x":119.5,"y":31.0,"z":-40.5,"yaw":90,"pitch":0.0}},"particle":"HAPPY_VILLAGER","count":12,"offset":{"x":0.6,"y":0.6,"z":0.6},"speed":0.02,"type":"spawn_particles","_genericBlueprint":null},{"id":"3NV1FOQq6obbndy","name":"cap1_granjero_campo","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"block.crop.break"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.8,"pitch":1.2},"type":"play_sound","_genericBlueprint":null},{"id":"d8jOCs4bWYTI6wL","name":"cap1_granjero_titulo_mision","criteria":[],"modifiers":[],"triggers":[],"title":"<#9EE37D>Nueva Misión","subtitle":"<#C9CDD6>Consigue 10 diamantes","durations":{"enabled":true,"value":{"fadeIn":400,"stay":2600,"fadeOut":600}},"type":"show_title","_genericBlueprint":null},{"id":"qeeHq1PkCJVuoYq","name":"cap1_granjero_sonido_mision","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"block.note_block.bell"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.8,"pitch":1.2},"type":"play_sound","_genericBlueprint":null},{"id":"LRqrxZKiGvbtcj7","name":"cap1_granjero_mision_oferta","criteria":[],"modifiers":[{"fact":"0lR8acRYSi4MDF8","operator":"=","value":1}],"triggers":["d8jOCs4bWYTI6wL","qeeHq1PkCJVuoYq"],"speaker":"tSIOdSmdNHnccmy","text":"Pero antes necesito un favor: los monstruos destrozaron mis herramientas. Tráeme <#7FD8FF>10 diamantes</#7FD8FF> y te pagaré bien, con comida incluida.","duration":1800,"type":"spoken","_genericBlueprint":null},{"id":"bsHXDYzEzVMGPBn","name":"cap1_granjero_quitar_diamantes","criteria":[],"modifiers":[],"triggers":[],"item":{"case":"custom_item","value":{"components":[{"case":"material","value":{"material":"DIAMOND"}},{"case":"amount","value":{"amount":10}}]}},"type":"remove_item","_genericBlueprint":null},{"id":"u3mY2lhm12FPzmV","name":"cap1_granjero_pago","criteria":[],"modifiers":[],"triggers":[],"amount":1500.0,"type":"deposit_balance","_genericBlueprint":null},{"id":"4eAk5M7ByFgDcEW","name":"cap1_granjero_comida","criteria":[],"modifiers":[],"triggers":[],"item":{"case":"custom_item","value":{"components":[{"case":"material","value":{"material":"COOKED_BEEF"}},{"case":"amount","value":{"amount":32}}]}},"type":"give_item","_genericBlueprint":null},{"id":"7AKW3gc3FnJxFkQ","name":"cap1_granjero_titulo_entrega","criteria":[],"modifiers":[],"triggers":[],"title":"<#FFD36B>Misión completada","subtitle":"<#7FFF9E>+2500 · 32 filetes","durations":{"enabled":true,"value":{"fadeIn":400,"stay":2600,"fadeOut":600}},"type":"show_title","_genericBlueprint":null},{"id":"jVDZRucq2zyw8GO","name":"cap1_granjero_sonido_entrega","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"entity.villager.celebrate"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.9,"pitch":1.0},"type":"play_sound","_genericBlueprint":null},{"id":"uLfafi1JrpRWBJG","name":"cap1_granjero_mision_entrega","criteria":[],"modifiers":[{"fact":"0lR8acRYSi4MDF8","operator":"=","value":2}],"triggers":["bsHXDYzEzVMGPBn","u3mY2lhm12FPzmV","4eAk5M7ByFgDcEW","7AKW3gc3FnJxFkQ","jVDZRucq2zyw8GO","iGpW5B9G0xQLOry"],"speaker":"tSIOdSmdNHnccmy","text":"¡Diez! Brillan como el sol —ese que ya no vemos. Toma tus monedas y algo de comida caliente: ahí fuera vas a necesitarla. Ahora sí, mi tienda es tu tienda.","duration":1800,"type":"spoken","_genericBlueprint":null},{"id":"9encC4davDsREym","name":"cap1_granjero_mision_recordatorio","criteria":[],"modifiers":[],"triggers":[],"speaker":"tSIOdSmdNHnccmy","text":"Todavía no. Necesito <#7FD8FF>10 diamantes</#7FD8FF> y llevas <#7FD8FF>%typewriter_kWCBX1KpeZUaLJ4%</#7FD8FF>. Baja a las profundidades: entre la capa -50 y -60 es donde más brillan.","duration":1800,"type":"spoken","_genericBlueprint":null},{"id":"CXkGKEqHOJsDztK","name":"cap1_herrero_fuera_tutorial","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":1},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":2},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":3},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":4},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":6}],"modifiers":[],"triggers":["0BFn7BwpkZ01BZG","Cl5ov9RttYnn1sC","IvaUojhbOIDYvGm","9pyaA6juCAGLlEc","Z4qTOWIsYy2e2Cn","ujYimKsT7nv4ur3"],"type":"simple_action","_genericBlueprint":null},{"id":"X7qTZcapnFy99dd","name":"cap1_chamana_fuera_tutorial","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":1},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":2},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":3},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":4},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":6}],"modifiers":[],"triggers":["0BFn7BwpkZ01BZG","TAA14vdnc2lOch8","46IC4ZulAqpNx9D","HG6HioLgyHSdPr4","Pyx8ZuTAVE14vtV","XKErhtRFKs2K9ff","pRPQ2CmfjASSGnw","cxsOsFg7fbGKZu7"],"type":"simple_action","_genericBlueprint":null},{"id":"5djgDrYoncgh4XL","name":"cap1_granjero_fuera_tutorial","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":1},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":2},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":3},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":4},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":6}],"modifiers":[],"triggers":["0BFn7BwpkZ01BZG","ktw7bxVzeQBHZ2h","SH5yUt2IYexHNdU","A2V4MBvAfAsdj4Z","fol1P3q0QvplGLk","UHI7PyJdHitjIbm","9JqzopIoSA0UqUO","3wmZ2uPETUW1Ajm"],"type":"simple_action","_genericBlueprint":null},{"id":"pRPQ2CmfjASSGnw","name":"cap1_chamana_aun_no","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"8HlrwYMfvea9lkx","operator":"==","value":0},{"fact":"wkkMxzwwM5hpA6e","operator":"==","value":0}],"modifiers":[],"triggers":[],"speaker":"pVLqPb5cMpkON74","text":"*Malvor abre los ojos de golpe y te observa.* Tu alma aún huele a forja… Antes de hablar conmigo, alguien en el reino debería ver de qué estás hecho. <#FFB347>Bram</#FFB347> no suele equivocarse.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"UHI7PyJdHitjIbm","name":"cap1_granjero_aun_no_herrero","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"8HlrwYMfvea9lkx","operator":"==","value":0},{"fact":"EfujfoRnxa6wHW3","operator":"==","value":0}],"modifiers":[],"triggers":[],"speaker":"tSIOdSmdNHnccmy","text":"¡Uy, perdona! Con tanto trabajo no te había visto. Si eres nuevo por aquí, la forja de <#FFB347>Bram</#FFB347> es donde empiezan todos los que llegan.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"9JqzopIoSA0UqUO","name":"cap1_granjero_aun_no_chamana","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"8HlrwYMfvea9lkx","operator":"==","value":1},{"fact":"wkkMxzwwM5hpA6e","operator":"==","value":0},{"fact":"EfujfoRnxa6wHW3","operator":"==","value":0}],"modifiers":[],"triggers":[],"speaker":"tSIOdSmdNHnccmy","text":"*Tobías baja la voz.* Malvor lleva toda la mañana preguntando por un forastero… ¿no serás tú? Yo no le haría esperar, que se pone raro con el incienso.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"ujYimKsT7nv4ur3","name":"cap1_herrero_saludo_turno","criteria":[],"modifiers":[],"triggers":[],"entity":"E7R5IiAWNKTJiHX","animation":"wave","animationSettings":{"lerpIn":250,"lerpOut":250,"speed":1,"force":false,"priority":-1},"type":"play_modelengine_animation","_genericBlueprint":null},{"id":"cxsOsFg7fbGKZu7","name":"cap1_chamana_saludo_turno","criteria":[],"modifiers":[],"triggers":[],"entity":"U4YD4MKVhEUFM6T","animation":"wave","animationSettings":{"lerpIn":250,"lerpOut":250,"speed":1,"force":false,"priority":-1},"type":"play_modelengine_animation","_genericBlueprint":null},{"id":"3wmZ2uPETUW1Ajm","name":"cap1_granjero_saludo_turno","criteria":[],"modifiers":[],"triggers":[],"entity":"ZonkP5GYIRkt5sr","animation":"wave","animationSettings":{"lerpIn":250,"lerpOut":250,"speed":1,"force":false,"priority":-1},"type":"play_modelengine_animation","_genericBlueprint":null},{"name":"cap1_herrero_mundo","speaker":"8t7mqaKzxEZUtub","text":"Bosques, montañas, cuevas y ruinas del Imperio. Lo que encuentres puedes venderlo, usarlo para mejorar tu equipo o para levantar tu propio hogar. Eso sí: de noche, no te alejes de la luz.","duration":1000,"type":"spoken","criteria":[],"modifiers":[],"triggers":[],"id":"fr1gK3mqFhtVbE6","_genericBlueprint":null}],"chapter":"lore.capitulo1","priority":0,"version":"0.8.0"}