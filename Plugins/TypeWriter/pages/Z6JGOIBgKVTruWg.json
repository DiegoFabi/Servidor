],"modifiers":[],"triggers":[],"entity":"E7R5IiAWNKTJiHX","animation":"wave","animationSettings":{"lerpIn":250,"lerpOut":250,"speed":1,"force":false,"priority":-1},"type":"play_modelengine_animation","_genericBlueprint":null},{"id":"IvaUojhbOIDYvGm","name":"cap1_herrero_sonido_saludo","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"block.anvil.place"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.6,"pitch":1.2},"type":"play_sound","_genericBlueprint":null},{"id":"Z4qTOWIsYy2e2Cn","name":"cap1_herrero_opciones","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"8HlrwYMfvea9lkx","operator":"==","value":1}],"modifiers":[],"triggers":[],"speaker":"8t7mqaKzxEZUtub","text":"El yunque no espera. ¿Qué necesitas?","options":[{"text":"<#FFB347>✦ Malvor me envía","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":2}],"modifiers":[],"triggers":["Ux4aXAkozq8uZJq"]},{"text":"<#FFB347>✦ Entregar los materiales","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":3},{"fact":"2hc7nJNGAizu3Jr","operator":">=","value":24},{"fact":"NDnsmrJf3vzOQ82","operator":">=","value":32},{"fact":"LSVdZB5uougDEz3","operator":">=","value":48}],"modifiers":[],"triggers":["SLtemKkaf6nxha1"]},{"text":"Sobre la llave…","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":3}],"modifiers":[],"triggers":["O6FEtmcp5T2M5bj"]},{"text":"He perdido la Llave de Raíz…","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":">=","value":4},{"fact":"KPiLyCJNOKjip5B","operator":"<=","value":6},{"fact":"kWiCKeGPJTGR9ot","operator":"==","value":0}],"modifiers":[],"triggers":["cAqhhRcStPyz3lj"]},{"text":"<#FFB347>⚒ Abrir la Herrería","criteria":[],"modifiers":[],"triggers":["7eJZXwoR4JuqsdM"]},{"text":"¿Qué le pasó a tu clan?","criteria":[],"modifiers":[],"triggers":["fI4BRDcrD77MuBV"]},{"text":"¿Algún consejo?","criteria":[],"modifiers":[],"triggers":["hexlhHNPZDj004b"]}],"duration":1000,"type":"option","_genericBlueprint":null},{"id":"dO67MbO63ZJzqk5","name":"cap1_herrero_no_te_conozco","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":5}],"modifiers":[],"triggers":[],"message":"<#FFB347>✦ <#C9CDD6>«No te conozco…» <#9EA3AE>Termina el tutorial primero","type":"action_bar_simple_message","_genericBlueprint":null},{"id":"9pyaA6juCAGLlEc","name":"cap1_herrero_presentacion_1","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":5},{"fact":"8HlrwYMfvea9lkx","operator":"==","value":0}],"modifiers":[],"triggers":["lE4Ivwpm1eUArqs"],"speaker":"8t7mqaKzxEZUtub","text":"¡Eh, tú! Otro que vuelve de la tierra con cara de no saber dónde está. Tranquilo, aquí todos hemos revivido alguna vez.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"lE4Ivwpm1eUArqs","name":"cap1_herrero_presentacion_2","criteria":[],"modifiers":[],"triggers":["jTaDjgzdWu252SY"],"speaker":"8t7mqaKzxEZUtub","text":"Soy Brom, el último herrero enano de este reino. El Rey me dejó su yunque —y una deuda que nunca pienso cobrar.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"jTaDjgzdWu252SY","name":"cap1_herrero_presentacion_3","criteria":[],"modifiers":[{"fact":"8HlrwYMfvea9lkx","operator":"=","value":1}],"triggers":["Fx0pOGHg9TBsg3u","hZQzsWPdwIaqZsF","pJEmNwzsXFL41Ew","Z4qTOWIsYy2e2Cn","iGpW5B9G0xQLOry"],"speaker":"8t7mqaKzxEZUtub","text":"Si necesitas mejorar tu equipo, ya sabes dónde encontrarme. Y ahora ve con <#C38BFF>Malvor</#C38BFF>, la chamán: ella escucha lo que los demás olvidamos.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"7eJZXwoR4JuqsdM","name":"cap1_herrero_abrir_herreria","criteria":[],"modifiers":[],"triggers":[],"command":"core-menu menuHerrero %player_name%","type":"console_run_command","_genericBlueprint":null},{"id":"fI4BRDcrD77MuBV","name":"cap1_herrero_lore","criteria":[],"modifiers":[],"triggers":[],"speaker":"8t7mqaKzxEZUtub","text":"Mi clan forjó la corona del Rey. Cuando la Maleza la tocó, el metal empezó a cantar —y nosotros, a olvidar. Yo sigo martillando para no escucharla.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"hexlhHNPZDj004b","name":"cap1_herrero_consejo","criteria":[],"modifiers":[],"triggers":[],"speaker":"8t7mqaKzxEZUtub","text":"La piedra sirve para empezar, pero no para sobrevivir. Tráeme minerales y te haré algo que aguante más de una caída.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"Fx0pOGHg9TBsg3u","name":"cap1_herrero_chispas","criteria":[],"modifiers":[],"triggers":[],"location":{"enabled":true,"value":{"world":"Lobby","x":12.5,"y":-18.8,"z":-28.5,"yaw":90,"pitch":0.0}},"particle":"LAVA","count":8,"offset":{"x":0.4,"y":0.4,"z":0.4},"speed":0.05,"type":"spawn_particles","_genericBlueprint":null},{"id":"hZQzsWPdwIaqZsF","name":"cap1_herrero_humo","criteria":[],"modifiers":[],"triggers":[],"location":{"enabled":true,"value":{"world":"Lobby","x":12.5,"y":-18.5,"z":-28.5,"yaw":90,"pitch":0.0}},"particle":"LARGE_SMOKE","count":10,"offset":{"x":0.3,"y":0.3,"z":0.3},"speed":0.02,"type":"spawn_particles","_genericBlueprint":null},{"id":"pJEmNwzsXFL41Ew","name":"cap1_herrero_yunque","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"block.anvil.use"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.7,"pitch":0.8},"type":"play_sound","_genericBlueprint":null},{"id":"TJwwzZHhN8vzLw5","name":"cap1_chamana_interaccion","triggers":["X7qTZcapnFy99dd","WyMx1OtUz6QW3hq"],"definition":"pVLqPb5cMpkON74","shiftType":"ANY","interactionType":"RIGHT_CLICK","type":"entity_interact_event","_genericBlueprint":null},{"id":"TAA14vdnc2lOch8","name":"cap1_chamana_saludo","criteria":[],"modifiers":[],"triggers":[],"entity":"U4YD4MKVhEUFM6T","animation":"wave","animationSettings":{"lerpIn":250,"lerpOut":250,"speed":1,"force":false,"priority":-1},"type":"play_