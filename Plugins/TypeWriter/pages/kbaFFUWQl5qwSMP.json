ype":"play_sound","_genericBlueprint":null},{"id":"A3h7uGVKZQC18Gx","name":"open_menu_interact","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":1},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":2},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":3},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":4},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":6}],"modifiers":[],"triggers":[],"command":"core-menu panelTP","sudo":true,"type":"player_run_command","_genericBlueprint":null},{"id":"1eW4yIAzWBFY0AA","name":"interact_on_enderman_spawn","triggers":["0BFn7BwpkZ01BZG","sFo2g5sTS0K84rB","Z8DhOJGpoDGqckd","iVL7aXeevDBOquG","01dI2ku0UZVOyUp","Hv470Ackb1MjyvJ"],"definition":"M6yCZ2VDNhAc0FU","shiftType":"ANY","interactionType":"RIGHT_CLICK","type":"entity_interact_event","_genericBlueprint":null},{"id":"sFo2g5sTS0K84rB","name":"ender_options","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":1},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":2},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":3},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":4},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":6}],"modifiers":[],"triggers":[],"speaker":"DRNRZT4qzLBNZcM","text":"ᴇɴᴛɪᴅᴀᴅ ᴍɪꜱᴛɪᴄᴀ ᴅᴇʟ ᴛᴇʟᴇᴛʀᴀɴꜱᴘᴏʀᴛᴇ","options":[{"text":"Abrir Menú de Transporte","criteria":[],"modifiers":[],"triggers":["SNu1tV0qGTXv6Tq","HxO3dufl20XUd7I"]},{"text":"Conversar con <#BE27F5>Enderman","criteria":[],"modifiers":[],"triggers":["Q9gNalt8D3WOB0H",null]},{"text":"Solo Estaba de Paso... <#F52727>Cerrar","criteria":[],"modifiers":[],"triggers":["l3HHh9nExc3dmRt","HxO3dufl20XUd7I"]}],"duration":1000,"type":"option","_genericBlueprint":null},{"id":"Gfe20bU4S5ekP11","name":"two_spoken","criteria":[],"modifiers":[],"triggers":["4BJLE7AIkSb8O0y","HxO3dufl20XUd7I"],"speaker":"DRNRZT4qzLBNZcM","text":"¿Sorprendido? No eres el único con… anomalías. Aunque claro, tú hablas mucho más de lo que deberías.","duration":3000,"type":"spoken","_genericBlueprint":null},{"id":"utjanAcgLjNgFpE","name":"three_spoken","criteria":[],"modifiers":[],"triggers":["4BJLE7AIkSb8O0y","HxO3dufl20XUd7I"],"speaker":"DRNRZT4qzLBNZcM","text":"Te he visto caer… y levantarte… demasiadas veces. Como la maleza después de la tormenta… siempre regresas, aunque deberías estar pudriéndote bajo tierra —sin ofender.","duration":3000,"type":"spoken","_genericBlueprint":null},{"id":"6aj6i7yFj4Jm84z","name":"four_spoken","criteria":[],"modifiers":[],"triggers":["4BJLE7AIkSb8O0y","HxO3dufl20XUd7I"],"speaker":"DRNRZT4qzLBNZcM","text":"Cuidando las ruinas… o tal vez esperando. No recuerdo. El tiempo aquí se dobla, de todos modos lo unico que recuerdo es que debo ayudarte a teletransportarte, asi que, cuenta conmigo.","duration":3000,"type":"spoken","_genericBlueprint":null},{"id":"4BJLE7AIkSb8O0y","name":"stop_sound","criteria":[],"modifiers":[],"triggers":[],"sound":{"enabled":false,"value":{"value":"music.overworld.cherry_grove","type":"default"}},"type":"stop_sound","_genericBlueprint":null},{"id":"iVL7aXeevDBOquG","name":"stop_all_sounds_first","criteria":[],"modifiers":[],"triggers":["4AvE5kPOGGlrjxR"],"sound":{"enabled":false,"value":{"type":"default","value":""}},"type":"stop_sound","_genericBlueprint":null}],"chapter":"talkings.spawn","priority":0,"version":"0.8.0"}