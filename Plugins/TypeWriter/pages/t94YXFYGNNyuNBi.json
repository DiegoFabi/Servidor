{"id":"t94YXFYGNNyuNBi","name":"king_spawn_talking","type":"sequence","entries":[{"id":"cuS5TZI3WECEsjK","name":"king_interaction_menu","triggers":["ADUC7O9ZMgyaZRG","Hv470Ackb1MjyvJ"],"definition":"Mv89CaytjuA5znG","shiftType":"ANY","interactionType":"LEFT_CLICK","type":"entity_interact_event","_genericBlueprint":null},{"id":"ADUC7O9ZMgyaZRG","name":"menu_main_command_run","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":1},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":2},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":3},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":4},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":6}],"modifiers":[],"triggers":[],"command":"commandpanel menuMain","sudo":false,"type":"player_run_command","_genericBlueprint":null},{"id":"oJiRV3aNw6f25Di","name":"sound_king","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":1},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":2},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":3},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":4},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":6}],"modifiers":[],"triggers":[],"sound":{"soundId":{"value":"entity.pillager.ambient","type":"default"}},"type":"play_sound","_genericBlueprint":null},{"id":"G7Ii2KZMU5zR8lb","name":"first_spoken","criteria":[],"modifiers":[],"triggers":["jGBrBzan8yebolA","oJiRV3aNw6f25Di"],"speaker":"bPwYtnQSHNNisZP","text":"Oh… has vuelto. Otra vez. Y sin recuerdos, como siempre. La maleza devoró mi reino… y a ti parece devorarte la memoria. En fin… supongo que me toca recordarte lo que olvidaste.","duration":3000,"type":"spoken","_genericBlueprint":null},{"id":"APtfcIeiVnKGrgo","name":"open_main_menu","criteria":[],"modifiers":[],"triggers":[],"command":"commandpanel menuMain","sudo":true,"type":"player_run_command","_genericBlueprint":null},{"id":"JRYAWzgKY16rrmM","name":"first_option","criteria":[],"modifiers":[],"triggers":["HxO3dufl20XUd7I","l3HHh9nExc3dmRt"],"speaker":"bPwYtnQSHNNisZP","text":"Más veces de las que puedo contar. Siempre vuelves —pero nunca eres el mismo.","duration":2000,"type":"spoken","_genericBlueprint":null},{"id":"zZ0L7ouNlgcMhHR","name":"second_option","criteria":[],"modifiers":[],"triggers":["l3HHh9nExc3dmRt","HxO3dufl20XUd7I"],"speaker":"bPwYtnQSHNNisZP","text":"La maleza lo reclamó… como hace con todo. Supongo que yo fui su postre.","duration":2000,"type":"spoken","_genericBlueprint":null},{"id":"ULJEjv9nrrZ7amF","name":"third_option","criteria":[],"modifiers":[],"triggers":["HxO3dufl20XUd7I","l3HHh9nExc3dmRt"],"speaker":"bPwYtnQSHNNisZP","text":"Podría decirte que es una maldición ancestral… pero la verdad, ni idea. Solo sé que no se detiene. Y tampoco tú.","duration":1000,"type":"spoken","_genericBlueprint":null},{"id":"jGBrBzan8yebolA","name":"player_options","criteria":[],"modifiers":[],"triggers":["oJiRV3aNw6f25Di"],"speaker":"IiY432VLyYHg26J","text":"ᴜɴᴀ ᴇɴᴛɪᴅᴀᴅ ᴄᴏɴ ᴄɪᴇʀᴛᴀꜱ ʜᴀʙɪʟɪᴅᴀᴅᴇꜱ","options":[{"text":"¿Así que ya nos habíamos visto antes?","criteria":[],"modifiers":[],"triggers":["JRYAWzgKY16rrmM"]},{"text":"¿Qué pasó con tu reino?","criteria":[],"modifiers":[],"triggers":["zZ0L7ouNlgcMhHR"]},{"text":"¿Por qué la maleza está aquí?","criteria":[],"modifiers":[],"triggers":["ULJEjv9nrrZ7amF"]}],"duration":2000,"type":"option","_genericBlueprint":null},{"id":"YHYOwZc5FavARAE","name":"main_king_options","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":1},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":2},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":3},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":4},{"fact":"epJL7EGWiFbCY2p","operator":"!=","value":6}],"modifiers":[],"triggers":["oJiRV3aNw6f25Di"],"speaker":"bPwYtnQSHNNisZP","text":"ʀᴇʏ ᴅᴇʟ ᴀɴᴛɪɢᴜᴏ ɪᴍᴘᴇʀɪᴏ ᴘʀᴏꜱᴘᴇʀᴏ","options":[{"text":"<#C38BFF>✦ Mostrar la Llave de Raíz","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":4},{"fact":"kWiCKeGPJTGR9ot","operator":">=","value":1}],"modifiers":[],"triggers":["JGEmrc3DOws85Nr"]},{"text":"<#C38BFF>✦ Brom forjó una llave para ti…","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":">=","value":4},{"fact":"KPiLyCJNOKjip5B","operator":"<=","value":6},{"fact":"kWiCKeGPJTGR9ot","operator":"==","value":0}],"modifiers":[],"triggers":["S1sw1FdURCQiFqH"]},{"text":"<#F86363>✦ Abrir las puertas de la cripta","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":6},{"fact":"kWiCKeGPJTGR9ot","operator":">=","value":1}],"modifiers":[],"triggers":["SxMGGBFNTEjNmss"]},{"text":"<#E0C28A>✦ Entregar la Crónica Restaurada","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":15},{"fact":"O6vPcgKXIu9FimN","operator":">=","value":1}],"modifiers":[],"triggers":["BkD7W3WAOn7v0jz"]},{"text":"<#E0C28A>✦ Aldric te envía una crónica…","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":15},{"fact":"O6vPcgKXIu9FimN","operator":"==","value":0}],"modifiers":[],"triggers":["aDuUyb8PTcUYrKS"]},{"text":"<#C38BFF>✦ ¿Qué pasará ahora?","criteria":[{"fact":"KPiLyCJNOKjip5B","operator":"==","value":16}],"modifiers":[],"triggers":["Qs4bIR2BgnKqOZa"]},{"text":"Interactuar con <yellow>King Draemir</yellow>","criteria":[],"modifiers":[],"triggers":["G7Ii2KZMU5zR8lb"]},{"text":"Interactuar y <#49F527>Menú Prinicipal","criteria":[],"modifiers":[],"triggers":["APtfcIeiVnKGrgo"]},{"text":"Regresare Despues <red>Cerrar</red>","criteria":[],"modifiers":[],"triggers":["HxO3dufl20XUd7I"]}],"duration":1000,"type":"option","_genericBlueprint":null},{"id":"0qhydjMUlqbsYzF","name":"music_during_talking","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"value":"music.dragon","type":"default"}},"type":"play_sound","_genericBlueprint":null},{"id":"LvZ9sfITiN7jKed","name":"interaction_bound_with_king","criteria":[],"modifiers":[],"triggers":[],"interruptTriggers":[],"radius":5,"npc":"nabr06CAMsQQKEr","type":"look_at_entity_interaction_bound","_genericBlueprint":null},{"id":"xbwWwNbTZlQaFqE","name":"king_interaction","triggers":["oJiRV3aNw6f25Di","YHYOwZc5FavARAE","LvZ9sfITiN7jKed","3GHNRG7jznyGTd6","BtBJNDk4dCi3hmu","hU2bHhFxPoIPNwR","YFj49N66wM2PlIp"],"definition":"Mv89CaytjuA5znG","shiftType":"ANY","interactionType":"RIGHT_CLICK","type":"entity_interact_event","_genericBlueprint":null},{"id":"3GHNRG7jznyGTd6","name":"stop_all_sounds","criteria":[],"modifiers":[],"triggers":["0qhydjMUlqbsYzF"],"sound":{"enabled":false,"value":{"type":"default","value":""}},"type":"stop_sound","_genericBlueprint":null},{"id":"EH4SGXPDzKk5DBZ","name":"tutorial_rey_libro","criteria":[],"modifiers":[],"triggers":["rBHZQcWkLdx53xA","rtqzOWKNz2x6k7t"],"speaker":"bPwYtnQSHNNisZP","text":"¿Otra vez tú? Ese libro que ves es lo único que la Maleza no pudo arrancarte: lo escribiste tú mismo —vida tras vida— para no perderte del todo. Ahora vuelve a ser tuyo.","duration":2500,"type":"spoken","_genericBlueprint":null},{"id":"rtqzOWKNz2x6k7t","name":"tutorial_sonido_rey","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"entity.pillager.ambient"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.8,"pitch":0.9},"type":"play_sound","_genericBlueprint":null},{"id":"rBHZQcWkLdx53xA","name":"tutorial_rey_sin_tiempo","criteria":[],"modifiers":[],"triggers":["qpUhYzbObKqntcq"],"speaker":"bPwYtnQSHNNisZP","text":"No tengo tiempo para explicártelo todo: la raíz bajo mi trono no espera a nadie. Así que escucha bien, porque solo lo diré una vez.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"qpUhYzbObKqntcq","name":"tutorial_rey_funciones","criteria":[],"modifiers":[],"triggers":["PQaTKGrskWllylM"],"speaker":"bPwYtnQSHNNisZP","text":"En ese libro está todo lo que necesitas: el <yellow>Pase de Batalla</yellow> y sus recompensas, tus <yellow>Mascotas</yellow>, la <yellow>Tienda</yellow>, los <yellow>Trabajos</yellow> con los que ganarás monedas, las <yellow>Misiones</yellow> y los <yellow>Duelos</yellow>. Ábrelo cuando seas libre.","duration":2500,"type":"spoken","_genericBlueprint":null},{"id":"PQaTKGrskWllylM","name":"tutorial_rey_mision","criteria":[],"modifiers":[{"fact":"epJL7EGWiFbCY2p","operator":"=","value":2},{"fact":"26auCJp8cHzlQEW","operator":"=","value":2}],"triggers":["3rcZXgWF7CtOEUs","JKfBmxs8xTcUtQJ","fI6Fk3G0XTTvv27"],"speaker":"bPwYtnQSHNNisZP","text":"Pero antes demuestra que aún puedes recordar. Ve al <#7FB2FF>Eco de los Recuerdos</#7FB2FF>: un lugar marcado por un fragmento que flota en el aire. Sigue el rastro blanco hasta él y acércate. Allí recuperarás tu primer recuerdo.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"3rcZXgWF7CtOEUs","name":"tutorial_titulo_mision","criteria":[],"modifiers":[],"triggers":[],"title":"<#7FB2FF>Nuevo Destino","subtitle":"<#C9CDD6>Eco de los Recuerdos","durations":{"enabled":true,"value":{"fadeIn":500,"stay":3500,"fadeOut":800}},"type":"show_title","_genericBlueprint":null},{"id":"JKfBmxs8xTcUtQJ","name":"tutorial_sonido_mision","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"block.amethyst_block.chime"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.8,"pitch":1.2},"type":"play_sound","_genericBlueprint":null},{"id":"YFj49N66wM2PlIp","name":"tutorial_rey_recuerdo","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":-1}],"modifiers":[{"fact":"epJL7EGWiFbCY2p","operator":"=","value":4},{"fact":"BVjb2A1NPXIyzSr","operator":"=","value":1}],"triggers":["1j4WfmA5uf4INBG","Gy3sXhdptfC7hCg","ZWzfDD8wLuW6RQp","qb3ohf6WeqPeGWy"],"speaker":"bPwYtnQSHNNisZP","text":"Lo sentiste, ¿verdad? Un recuerdo vuelve a su sitio. Desde ahora tu historia quedará escrita y podrás revisarla cuando quieras.","duration":2000,"type":"spoken","_genericBlueprint":null},{"id":"1j4WfmA5uf4INBG","name":"tutorial_titulo_historia","criteria":[],"modifiers":[],"triggers":[],"title":"<#FFD36B>Historia","subtitle":"<#C9CDD6>Usa <yellow>/historia","durations":{"enabled":true,"value":{"fadeIn":500,"stay":4000,"fadeOut":800}},"type":"show_title","_genericBlueprint":null},{"id":"Gy3sXhdptfC7hCg","name":"tutorial_sonido_historia","criteria":[],"modifiers":[],"triggers":[],"sound":{"soundId":{"type":"default","value":"ui.toast.challenge_complete"},"soundSource":{"type":"self","entryId":"","location":{"world":"","x":0,"y":0,"z":0,"yaw":0,"pitch":0}},"track":"MASTER","volume":0.6,"pitch":1.0},"type":"play_sound","_genericBlueprint":null},{"id":"ZWzfDD8wLuW6RQp","name":"tutorial_consola_historia","criteria":[],"modifiers":[],"triggers":[],"command":"tutorial historia %player_name% 1\ntutorial paso %player_name% 4","type":"console_run_command","_genericBlueprint":null},{"id":"qb3ohf6WeqPeGWy","name":"tutorial_rey_ve_al_guardia","criteria":[],"modifiers":[],"triggers":[],"speaker":"bPwYtnQSHNNisZP","text":"Ahora ve con el <yellow>Guardia Real</yellow>; sigue el rastro blanco. Él sabrá qué hacer contigo —yo ya no tengo tiempo.","duration":1500,"type":"spoken","_genericBlueprint":null},{"id":"BtBJNDk4dCi3hmu","name":"tutorial_bloqueo_rey","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":">=","value":2},{"fact":"epJL7EGWiFbCY2p","operator":"<=","value":4}],"modifiers":[],"triggers":[],"message":"<#FFB347>✦ <#C9CDD6>Sigue el rastro blanco del tutorial","type":"action_bar_simple_message","_genericBlueprint":null},{"id":"fI6Fk3G0XTTvv27","name":"tutorial_consola_paso_2","criteria":[],"modifiers":[],"triggers":[],"command":"tutorial paso %player_name% 2","type":"console_run_command","_genericBlueprint":null},{"id":"hU2bHhFxPoIPNwR","name":"escena_libro_del_rey","criteria":[{"fact":"epJL7EGWiFbCY2p","operator":"==","value":1}],"modifiers":[],"triggers":["EH4SGXPDzKk5DBZ"],"blockChatMessages":true,"blockActionBarMessages":true,"page":"iBCZxB7gkzNFbvp","type":"cinematic","_genericBlueprint":null}],"chapter":"talkings.spawn","priority":0,"version":"0.8.0"}